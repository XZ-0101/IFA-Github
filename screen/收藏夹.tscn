[sub_resource type="GDScript" id="GDScript_tbo6j"]
resource_name = "scj"
script/source = "extends Control
var jumper_array:Array[jumper_class]

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	for i in Get.收藏夹:
		var b =preload(\"res://screen/jumper_button.tscn\").instantiate()
		b.jumper=i
		$ScrollContainer3/VBoxContainer.add_child(b)
	
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	
	pass


func _on_button_button_down() -> void:
	$CanvasLayer.a=Get.收藏夹
	$CanvasLayer.mode_=\"lobotomyA\"
	$CanvasLayer.show()
	pass # Replace with function body.


func _on_button_2_button_down() -> void:
	$CanvasLayer.a=Get.收藏夹
	$CanvasLayer.mode_=\"lobotomyAS\"
	$CanvasLayer.show()
	pass # Replace with function body.


func _on_button_3_button_down() -> void:
	$CanvasLayer.a=Get.收藏夹
	$CanvasLayer.mode_=\"type\"
	$CanvasLayer.show()
	pass # Replace with function body.


func _on_button_4_button_down() -> void:
	#$Button4.hide()
	var r=shou_cang_jia.new()
	r.array=Get.收藏夹
	ResourceSaver.save(r,\"user://scj.tres\")
	OS.alert(\"已保存\")
	pass # Replace with function body.
"

