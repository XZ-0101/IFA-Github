[sub_resource type="GDScript" id="GDScript_obbsc"]
script/source = "extends RichTextLabel

@export var min_font_size: int = 8
@export var default_font_size: int = 16

var _current_text: String = \"\"
var _is_adjusting: bool = false
var _pending_adjust: bool = false

func _ready():
	fit_content = false
	bbcode_enabled = true
	resized.connect(_on_resized)
	call_deferred(\"_request_adjust\")

func update_text(new_text: String) -> void:
	if _current_text == new_text:
		return
	_current_text = new_text
	super.set_text(new_text)
	_request_adjust()

func _on_resized():
	_request_adjust()

func _exit_tree():
	# 断开信号，防止在销毁后仍被触发
	if resized.is_connected(_on_resized):
		resized.disconnect(_on_resized)

func _request_adjust():
	if not is_inside_tree():
		return
	if _is_adjusting:
		_pending_adjust = true
		return
	_is_adjusting = true
	await _adjust_font_size()
	_is_adjusting = false
	if _pending_adjust:
		_pending_adjust = false
		_request_adjust()

func _adjust_font_size():
	if not is_inside_tree():
		return

	await get_tree().process_frame
	if not is_inside_tree():
		return

	var target_height = size.y
	if target_height <= 0:
		return

	var current_font_size = get_theme_font_size(\"normal_font_size\")
	var content_height = get_content_height()
	if content_height <= target_height and current_font_size == default_font_size:
		return

	var low = min_font_size
	var high = default_font_size
	var best = default_font_size

	while low <= high:
		var mid = (low + high) / 2
		add_theme_font_size_override(\"normal_font_size\", mid)

		await get_tree().process_frame
		if not is_inside_tree():
			return

		var cur_height = get_content_height()
		if cur_height <= target_height:
			best = mid
			low = mid + 1
		else:
			high = mid - 1

	if best != current_font_size:
		add_theme_font_size_override(\"normal_font_size\", best)
		await get_tree().process_frame
		# 最后再检查一次树状态（可选）
"

