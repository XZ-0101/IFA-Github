resource_name = "time"
script/source = "extends Control

var dic_week={
	1:\"一\",
	2:\"二\",
	3:\"三\",
	4:\"四\",
	5:\"五\",
	6:\"六\",
	0:\"日\",

}
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(delta: float) -> void:
	var dic=Time.get_datetime_dict_from_system()
	$Label.text=time_to_str(dic.hour)+\":\"+time_to_str(dic.minute)
	$Label2.text=str(dic.year)+\"年 \"+str(dic.month)+\"月\"+str(dic.day)+\"日\"+\"\\n[right]星期\"+dic_week.get(dic.weekday)
	$Label3.text=\"SC\\n\"+time_to_str(dic.second)
	pass
func time_to_str(time:int):
	if time>9:
		return str(time)
	else :
		return \"0\"+str(time)
"

