[sub_resource type="GDScript" id="GDScript_28wpi"]
resource_name = "CHARA_CHAT"
script/source = "extends Control

@export var texture:TextureRect
@export var text:RichTextLabel
@export var an:AnimationPlayer
@export var edit:TextEdit
@export var window:Window
@export var file:FileDialog
@export var file_load:FileDialog
@export var file_save:FileDialog
var chat:Array=[
	\"哈欠……经理老爷可真是个勤恳的人啊。这个点是怎么让自己保持清醒的啊…？\",
	\"汝对午饭有何打算？听闻罗佳打听到了不错的食堂，吾现在十分期待。\",
	\"今天的星星格外明亮。经理老爷也看得见星星吗？\",
	\"经理老爷，要欣赏一下吗？此皆吾之珍宝，呼呼……其中不乏吾竭尽全力才得到的限量版！\",
	\"请把目光投向那些收尾人吧，他们正为了这世间的正义而奔波！不觉得他们是如此耀眼吗？\",
	\"经理老爷最喜欢的收尾人是谁？分您一个徽章贴在衣服上如何？\",
]
var now_chat:Array
var chat_ind:int

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if FileAccess.file_exists(\"user://chara_show.tres\") and Get.going_to_load_res:
		Loading.load_to(\"user://chara_show.tres\",3)
		await Loading.load_over
		texture.texture=Get.going_to_load_res.img
		chat=Get.going_to_load_res.chat
	if DirAccess.dir_exists_absolute(Get.our_dir.path_join(\"SI_pack\")):
		file_load.root_subfolder=Get.our_dir.path_join(\"SI_pack\")
		file_save.root_subfolder=Get.our_dir.path_join(\"SI_pack\")
	if Get.si_path and FileAccess.file_exists(Get.si_path):
		read_it(Get.si_path)
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_change_button_down() -> void:
	file.popup()
	pass # Replace with function body.


func _on_hide_button_down() -> void:
	an.play_backwards(\"show\")
	pass # Replace with function body.


func _on_chat_button_down() -> void:
	window.popup()
	pass # Replace with function body.


func _on_button_button_down() -> void:
	if now_chat.size()==0:
		var hour=Time.get_datetime_dict_from_system().hour
		if hour>=6 and hour <=11:
			now_chat.append(chat[0].format({\"e1\":'\"',\"e2\":\",\",\"n\":\"\\n\"}))
		elif  hour >11 and hour <=18:
			now_chat.append(chat[1].format({\"e1\":'\"',\"e2\":\",\",\"n\":\"\\n\"}))
		else :
			now_chat.append(chat[2].format({\"e1\":'\"',\"e2\":\",\",\"n\":\"\\n\"}))
		now_chat.append(chat[3].format({\"e1\":'\"',\"e2\":\",\",\"n\":\"\\n\"}))
		now_chat.append(chat[4].format({\"e1\":'\"',\"e2\":\",\",\"n\":\"\\n\"}))
		now_chat.append(chat[5].format({\"e1\":'\"',\"e2\":\",\",\"n\":\"\\n\"}))
		
		text.update_text(now_chat.front())
		now_chat.erase(now_chat.front())
		an.seek(0)
		an.play(\"show\")
	else :
		text.update_text(now_chat.front())
		now_chat.erase(now_chat.front())
		an.seek(0)
		an.play(\"show\")
		
		pass
	
	pass # Replace with function body.


func _on_window_close_requested() -> void:
	window.hide()
	pass # Replace with function body.
func load_img_file(path:String):
	var file_ = FileAccess.open(path, FileAccess.READ)
	var data_ = file_.get_buffer(file_.get_length())
	
	var image = Image.new()
	var extension = path.get_extension().to_lower()
	var image_format
	match extension:
		\"png\":
			image_format = \"png\"
			image.load_png_from_buffer(data_)
		\"jpg\", \"jpeg\":
			image_format = \"jpg\"
			image.load_jpg_from_buffer(data_)
		\"webp\":
			image_format = \"webp\"
			image.load_webp_from_buffer(data_)
	
	var texture_ = ImageTexture.create_from_image(image)
	return texture_

func load_img_file_from_zip(path:String):
	
	var data_ = Zip.reader.read_file(path)
	
	var image = Image.new()
	var extension = path.get_extension().to_lower()
	var image_format
	match extension:
		\"png\":
			image_format = \"png\"
			image.load_png_from_buffer(data_)
		\"jpg\", \"jpeg\":
			image_format = \"jpg\"
			image.load_jpg_from_buffer(data_)
		\"webp\":
			image_format = \"webp\"
			image.load_webp_from_buffer(data_)
	
	var texture = ImageTexture.create_from_image(image)
	return texture

func _on_file_dialog_file_selected(path: String) -> void:
	var t = load_img_file(path)
	texture.texture=t
	pass # Replace with function body.


func _on_chat_op_item_selected(index: int) -> void:
	chat_ind=index
	edit.text=chat[chat_ind].format({\"e1\":'\"',\"e2\":\",\",\"n\":\"\\n\"})
	pass # Replace with function body.


func _on_chat_acc_button_down() -> void:
	chat[chat_ind]=edit.text.format({'\"':\"e1\",\",\":\"e2\",\"\\n\":\"n\"})
	pass # Replace with function body.


func _on_save_button_down() -> void:
	file_save.popup()
	pass # Replace with function body.


func _on_load_button_down() -> void:
	file_load.popup()
	pass


func _on_file_dialog_load_file_selected(path: String) -> void:
	Get.si_path=path
	read_it(path)

func read_it(path):
	var d=read_res(path)
	var c= chara_show.new()
	c.img=load_img_file_from_zip(d[6])
	c.chat.append(d[0])
	c.chat.append(d[1])
	c.chat.append(d[2])
	c.chat.append(d[3])
	c.chat.append(d[4])
	c.chat.append(d[5])
	texture.texture=c.img
	chat=c.chat
	now_chat=[]
	pass 
func read_res(path:String):
	#if OS.get_name()==\"Android\":
		#res_pack_Folder=OS.get_user_data_dir()+\"/res\"
	#else :
		#var path_a=path.split(\"/\")
		#path_a.remove_at(path_a.size()-1)
		#path_a.remove_at(path_a.size()-1)
#
		#print(path_a)
		#var f_path:String
		#for i in path_a:
			#f_path+=i+\"/\"
		#f_path.erase(f_path.length()-1)
		#res_pack_Folder=f_path
	Zip.reader.open(path)
	
	var dir=Zip.reader.get_files()[0]
	var b
	if dir.ends_with(\"txt\"):
		b=Zip.reader.read_file(dir)
	else :
		print(dir+\"dia.txt\")
		b=Zip.reader.read_file(dir+\"dia.txt\")
	
	var data=b.get_string_from_utf8()
	var data_array=data.split(\",\")
	print(data_array)
	return data_array





func _on_file_dialog_save_file_selected(path: String) -> void:
	var img=texture.texture.get_image().save_png_to_buffer()
	print(path)
	var packer=ZIPPacker.new()
	var dia:String=\"\"
	for i in chat:
		dia+=i+\",\"
	var n=path.get_file().get_basename()
	dia+=\"chara.png\"
	packer.open(path)
	packer.start_file(\"dia.txt\")
	packer.write_file(dia.to_utf8_buffer())
	packer.close_file()
	
	packer.start_file(\"chara.png\")
	packer.write_file(img)
	packer.close_file()
	packer.close()
	OS.alert(\"保存完成\")
	pass # Replace with function body.
"

