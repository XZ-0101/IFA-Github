[node name="指令" type="Control" unique_id=298415755]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = SubResource("GDScript_glfbb")
zl = Array[String](["去街头跳桑巴持续34个小时，直至一名绿色长发女性称赞你的舞蹈。", "算尽圆周率后杀死你所属巢中的科学家。", "游玩图书馆所有的邪神MOD", "每天，扮演为一名红眼，贫乳，患有中二病的魔法师对着某处大喊一声Explosion", "协助编写组编辑一个异想体的全部资料，时限是五天", "不要执行此指令", "杀死你的带着面具的妹夫", "_CLEAR._", "与自己今天遇见的第64人共享午餐", "杀死自己见到的第91个人", "在9点至11点之间， 找到K公司未稀释的安瓿中，跳入其中", "死前朗读“痛苦啊，你是我的唯一”", "杀死一名蓝发的图书馆馆长", "在5点至23点之间，将女儿的房间里灌满水", "在H巢的某处阳伞下，品尝红茶，期限3天", "成为蜘蛛巢的一名教师，令义秀体验星刀", "在倒满牛奶的泳池里舞蹈", "制作便当，在下午1点时于11区内的垃圾桶上享用它。", "在时针位于7与8之间时制作蛋白酥皮奶油卷筒并一边看电影一边享用它。", "和你今天遇到的前五个人中的第5位进行折手指游戏。手指折下去时需要被折断。", "将你所遇到的第62个人的指甲修剪整齐。", "抚摸5次用四足行走的动物。", "通过旋转转盘选出某个被指定的人并朝他扔蛋糕。", "吃放置在常温环境下的螃蟹与熟透了的柿子，每样各吃8个。", "在屋顶的围栏上大声喊出你所厌恶的人的名字后跳下屋顶。屋顶距离地面的高度无关紧要。", "将用餐后余下的碗全部丢弃。", "于接受指令后的第二天早上睁开眼睛时便立刻喝下3杯水。", "与居住在同一栋楼中的居民们一同进行一场目的地为7区的赛跑比赛。每隔23分钟便测量一次距离，测量距离时与7区相距最远的人将会被淘汰。", "在3天内织好一条带有蝴蝶图案的围巾。", "随意地拨一通电话。为接电话的人送上新年贺词。", "在白色的墙壁上看到绿色。", "在你肚子饿时吃添加了洋葱的鸡肉奶酪汉堡。", "折39个纸鹤并令它们在屋顶上飞扬。", "把首个在职场中大声训斥你的人的耳朵剪掉。", "与和自己视线相交了的人打招呼。", "立刻回家。有狗在家门前叫过一次后才可以出来。", "身着淡绿色的衣物并在三角形的街道上走十步。", "拌以只吃泡沫塑料长大的黄粉虫，海鲜奶油意粉酱涂抹3次后用叉子将其吃掉。", "杀掉你画的画", "将你的声带在沸腾的盐水中烹煮14秒，并将其作为晚餐的配菜食用", "连接Gesellschaft，并了解三件你所不知道的事", "一周之内，在B区十字路口与苦行者汇合，并在街上大步前行。补充。请跟随在最后到达的苦行者身后。", "登上三层以上的建筑物楼顶，向下方挥手一分钟", "作为当日的第三位客人进入卖炸鸡的餐厅，并最晚离开", "与三个以上的人一起玩捉迷藏后，与“鬼”一起回家。", "读六本书，并到访所读到的最后一本书中所出现的区域。期限为无限", "杀死巷子的巷子内的欺骗者", "穿着EGO::提灯，将其感应度设为120%，击杀一名环指大师", "对45进行390475178309次开方运算。补充，将结果刻在你见到的第e^(iπ) 人的背上", "与3-4名少女组成一只乐队，一支含有双马尾学妹作为节奏吉他手的乐队为最佳", "点一份披萨，在20分钟内1享用它。", "打电话告诉自己所有能联系到的人说自己要自杀，随后进入离你最近的房间，写下自己的遗书，随后拿出准备好的玩具左轮朝自己头上开六枪。", "与你认识的每一人说谢谢", "刺穿白鲸的心脏", "在读完自然常熟e之后，就可以回家了", "每天睡足共800小时，然后喝一杯热牛奶，活动之前请热身", "在30分钟内，找到一位新郎或者新娘，棕色头发为最佳", "在90小时以内，让他们吐露心声", "将你的房间粉饰一新，如画一般漂亮", "请用右手，吃饭写字或者扣下扳机", "请在400000处，右转", "进入L5123内的第四扇门中，先向右走14步，再向左走23步。", "自杀", "在十字路口前进3千米后左转再右转再左转再前进Cos90度纳米", "为美好的世界献上祝福", "给义秀喂奶", "游玩宝可梦，将主角命名为莉可，确保你的第一只宝可梦是新叶猫", "帮助主美回家", "加入阿库西斯教，期限2天", "称赞一名粉色头发的吉他手", "启动该图鉴中的FUN模式，打开别碰我的资料", "对一名路人大喊\"我能死亡回归\"，在此之后，捏碎他的心脏。", "完成ProjectMoon总监小金的核心抑制", "完成ProjectMoon总监小金的解放战", "陪伴ProjectMoon总监小金成功绽放EGO::ProjectMoon", "在阳光下，射杀一名阿拉伯人，后补四枪。"])

