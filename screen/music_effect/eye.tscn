[sub_resource type="GDScript" id="GDScript_1spxg"]
script/source = "extends Sprite2D

@export var offset_distance: float = 5.0 # 偏移的最大距离

func _process(delta):
	# 1. 算出从精灵指向鼠标的“方向向量”
	var direction = (get_global_mouse_position() - global_position).normalized()
	
	# 2. 让 Sprite2D 的 offset 属性等于“方向 * 偏移距离”
	# 这样它就会在自己的原始位置上，朝着鼠标的方向偏移一点点
	offset = direction * offset_distance
"

