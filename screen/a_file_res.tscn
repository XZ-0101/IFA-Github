[sub_resource type="GDScript" id="GDScript_lr3ln"]
script/source = "extends Control
signal down
@export var file:file_saver
@export var ind:int
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	
#region debug
	#var f =FileAccess.open(\"D:/pm_res_pack/wem/img2.jpg\",FileAccess.READ)
	#file.b=f.get_buffer(f.get_length())
	#f.close()
#endregion
	
	
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
func read_b(b:PackedByteArray,type:String):
	var image = Image.new()
	match  type:
		\"png\":
			
			image.load_png_from_buffer(b)
			var texture = ImageTexture.create_from_image(image)
			$VBoxContainer/TextureRect.texture=texture
		\"jpg\", \"jpeg\":
			
			image.load_jpg_from_buffer(b)
			var texture = ImageTexture.create_from_image(image)
			$VBoxContainer/TextureRect.texture=texture
		\"webp\":
			
			image.load_webp_from_buffer(b)
	
			var texture = ImageTexture.create_from_image(image)
			$VBoxContainer/TextureRect.texture=texture
		\"ogg\":
			var s =AudioStreamOggVorbis.load_from_buffer(b)
			$AudioStreamPlayer.stream=s
		\"mp3\":
			var s =AudioStreamMP3.load_from_buffer(b)
			$AudioStreamPlayer.stream=s
		\"wav\":
			var s = AudioStreamWAV.load_from_buffer(b)
			$AudioStreamPlayer.stream=s
	
	


func _on_button_2_toggled(toggled_on: bool) -> void:
	if $AudioStreamPlayer.stream:
		if toggled_on:
			$AudioStreamPlayer.play()
		else :
			$AudioStreamPlayer.stop()
	pass # Replace with function body.
func build():
	$VBoxContainer/HBoxContainer/Label.text=\"编号:\"+str(ind)
	$VBoxContainer/RichTextLabel.text=file.name_+\".\"+file.type
	read_b(file.b,file.type)
	match  file.type:
		\"png\",\"webp\",\"jpg\",\"jpeg\":
			$VBoxContainer/HBoxContainer/Button2.hide()
		\"wav\",\"mp3\",\"ogg\":
			$VBoxContainer/HBoxContainer/Button2.show()


func _on_button_button_down() -> void:
	emit_signal(\"down\")
	pass # Replace with function body.
"

