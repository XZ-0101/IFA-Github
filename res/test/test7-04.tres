other_info = "蓝色祭坛上放置着一颗蓝色的眼球。
[img]res://img2/TEST/07/P.webp[color=red]
石碑[/color]
"
other_info_act = "蓝色的机制与其他祭坛全然不同。它会在设施内的随机走廊生成一团气态的物体，这个物体的中央有一颗巨大的蓝色眼球及数颗小而尖锐的牙齿，它在显形时会每1秒对处于其动画范围中的所有单位造成一次5-7点灵魂伤害；若处于隐形状态，则它不会造成任何伤害。眼睛在生成后会随机寻找走廊停留，且只会在走廊停留。它每次显形8-14秒。在消失约5秒后眼睛会重新显形。每隔25-30秒（第一次移动为10-15秒），眼睛会随机一个走廊并以极快的速度飘向那条走廊。在飘向新走廊的过程中若眼睛处于显形状态，其依旧能对路途上的所有单位造成伤害。

蓝色祭坛每损失最大生命值30%的生命值，蓝色眼球会强制终止其行动倒计时并立刻前往蓝色祭坛本体所在的走廊，并在该走廊停留5-10秒。在停留结束后，其会继续正常行动直至蓝色祭坛被摧毁。

"
place = "随机部门的走廊"
count = "4"
health = 6000
speed = "该单位无法运动"
ob_name = "蓝色祭坛"
color = "紫罗兰"
time = "午夜"
