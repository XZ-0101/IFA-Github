"
other_info_act = "白色祭坛会在生成10-15秒后在设施内的随机位置开启一道白色传送门，一段巨大的，布满白色螺纹的触手将从传送门中伸出。经过8-11秒的蓄力之后，白色触手将会扫过一块圆心角约呈120度的扇形区域，并对触碰到的所有单位造成45-60点精神伤害。白色触手到达指定位置后，会缩回传送门并连同传送门一起消失。这之后白色祭坛每隔25-30秒就会在设施内的随机位置再次开启传送门。

白色祭坛每损失最大生命值30%的生命值，就会在走廊两端各开启一道朝向为左和右的白色传送门，白色触手会以同样的机制发起攻击。需要注意的是，白色触手的伤害判定范围为贴图范围，攻击可能会伤害到处于走廊临近房间内的单位，乃至另一部门内的单位。"
place = "随机部门的走廊"
count = "4"
health = 6000
speed = "该单位无法运动"
ob_name = "白色祭坛"
color = "紫罗兰"
time = "午夜"
name_ = "白色祭坛"
icon = ExtResource("1_mw70f")
info_ = "*资料类型：考验

