[resource]
script = ExtResource("5_xcckt")
Attack_Type = 2
acctak_Damage = "1-3"
Probabilities_ = SubResource("Resource_3scdx")
most_pe_box = "14"
good_Mood_Range = "11-14"
bad_Mood_Range = "0-5"
Norm_Mood_Range = "6-10"
Qliphoth_Counter = "4"
Upgrades = Array[String](["Ⅰ. 当“老妇人”的收容单元内没有员工时，每完成一个异想体的工作，“老妇人”的逆卡巴拉计数器都会立刻减少。对“老妇人”完成任意工作后，它的逆卡巴拉计数器会立刻加一。（该条翻译有误。原文没有后半句，而且这后半句的情况也和实际情况不符，具体见下文。）", "Ⅱ. 当“老妇人”的逆卡巴拉计数器归零时，收容单元内会形成一团黑色物质。在看到“老妇人”的逆卡巴拉能量指数降得如此之低的情况下，我们决定称其为“孤独”。", "Ⅲ. 当“孤独”堆积起来后，它会缠上进入收容单元的员工。", "Ⅳ. 一旦“孤独”缠上某个员工后，该员工将会动弹不得并持续受到白色的精神伤害，直到“孤独”消失为止。"])
story = "这个异想体呈现出一位虚弱，上了年纪的老人的模样，不论是谁进入它的房间，它都会与之交谈。

虽然有时会不同，但它常以一句“孩子，孩子。你想不想听一则以前的故事？”作为开头。这则故事可能是一首像摇篮曲般安静哼唱的歌谣、一首意义不明的小诗、一篇普通的童话，或是一些谁都不知道是什么的东西。

它知晓世间每一则故事，在听众离开前，它一直不停地讲述着。

<摘录自访谈记录>
员工代号F5049：“她可能是所有异想体中最寂寞的存在，可以说她被孤独给淹没了。她希望通过讲故事来填补内心的空白。而故事需要有听众，所以每当有人在她的房间里，她就会设法去填补这个空白。当然，听她讲故事是非常危险的。她知道地球上存在的所有故事，有些甚至...不在地球上，她都知道。单凭我们的意志是坚持不住的，这简直能在瞬间把我们的大脑给融化掉。”"
Observation_level = "Ⅰ. 成功率 + 4%Ⅱ. 工作速度 + 6、解锁E.G.O饰品、护甲Ⅲ. 成功率 + 4%、解锁E.G.O武器Ⅳ. 工作速度 + 6"
flavour_text = Array[String](["我们对“老妇人”并不熟悉，工作指南必须被极其谨慎地制定。", "“老妇人”是一个会造成心理伤害的异想体。建议分配具有高精神状态的员工进行工作。", "“老妇人”可能会使员工陷入恐慌，但经过长时间的观察，我们已能渐渐了解它。", "你准备好听“老妇人”讲故事了吗？", "从“老妇人”的房间里传来令人窒息的寂静。", "渗透整个房间的寂静被摇椅所发出的可怕“吱哑”声打破。", "摇椅在发霉的地板上嘎吱作响。", "墙壁和地板都有许多裂缝。或许，连它们都忍受不了“老妇人”的故事。", "“老妇人”的故事里掺杂着诅咒，现在人们不得不仔细听它讲故事。", "“老妇人”的灵魂可能在很久以前就孤独地迷失了。", "也许它有许多令人着迷的故事，但它的故事中只有诅咒。", "它的故事充满了恶意，它们渗透到周围人的内心当中，致使他们进入难以忍受的世界。"])
other_info = "老妇人（O-01-12）是一个面色惨白，眼窝空洞且极度衰老的人形异想体。它身穿一条长长的蓝色裙子，一件褪了色的紫色上衣，头戴一顶白色棉帽，安详地坐在收容单元内的摇椅上。

[center]
[table=2]
[cell border=#ffffa1]基础工作速度[/cell][cell border=#ffffa1]工作冷却[/cell]
[cell border=#ffffa1]0.2[/cell][cell border=#ffffa1]10[/cell]
[/table]
[/center]

[img]res://img2/LCA/O-01-12/Old_Lady_Close-up.webp[color=red]
收容单元监控画面[/color]
"
other_info_act = "特殊能力
和管理须知不同，若老妇人的计数器不满，且有员工对它完成了工作结果为“良”或是“优”的工作，老妇人的计数器将会立刻增加1点。

当计数器归零时，老妇人的收容单元会被黑色的，类似于尘埃的“孤独”笼罩。

这时候如果有员工进入它的收容单元，这个员工会立即结束工作，站在收容单元的门外并被“孤独”缠绕，进入[url=n被控制]被控制[/url]状态，在30秒内每6秒受到1次4-6点[url=n无来源]无来源[/url]精神伤害，同时无法移动。

当某个员工被“孤独”缠绕后，老妇人的计数器将立刻恢复至最大值（不需要等待员工恢复正常）。

因Legacy版本的部分遗留，员工在被指派对该异想体进行工作时会有特殊台词，具体如下：

“又是那个可怕的故事？”
“绝不，它会逼疯我的。”
“比起听那愚蠢的故事我倒宁可耳背一点。”

