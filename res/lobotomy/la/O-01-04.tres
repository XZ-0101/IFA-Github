good_Mood_Range = "16-22"
bad_Mood_Range = "10-15"
Norm_Mood_Range = "0-9"
will_Breakthrough_containment = true
Qliphoth_Counter = "2"
red_def = 0.7
white_def = 1.2
black_def = 0.3
pale_def = 1.5
Upgrades = Array[String](["Ⅰ.当工作结果为差时，“憎恶女王”的逆卡巴拉计数器会立刻减少。", "Ⅱ.每当发生逆卡巴拉能量熔毁时，如果在先前熔毁等级中死亡的人员数量不足3名，“憎恶女王”的逆卡巴拉计数器会立刻减少。", "Ⅲ. 当“憎恶女王”的逆卡巴拉计数器为最大值时，对其完成工作的员工能够恢复生命值和精神值。", "Ⅳ.发生二级警报时，“憎恶女王”会自愿协助您镇压异想体。在“憎恶女王”协助镇压期间，如果设施内的人员死亡率超过了20%，“憎恶女王”会改变形态并变得极度危险，需要立刻镇压。", "Ⅴ.当“憎恶女王”的逆卡巴拉计数器降为1时，“憎恶女王”会陷入歇斯底里的状态。此状态会减少对其所有工作的基础成功率。", "Ⅵ.在“憎恶女王”处于歇斯底里状态时派遣员工对其进行工作，如果这次工作能够提取出16个或更多的PE-BOX，那么“憎恶女王”的逆卡巴拉计数器就会增加。", "Ⅶ. 在“憎恶女王”处于歇斯底里状态时派遣员工对其进行工作，如果这次工作提取出的PE-BOX少于16个，那么“憎恶女王”的逆卡巴拉计数器就会减少。"])
story = "这个异想体有着一位少女的外表，她总是以和平与正义为名，时刻准备着与恶人战斗。

通常情况下，这个异想体对员工十分礼貌友好，可以随意同她交谈。她一直坚信着自己是个拯救世界的大英雄，并引以为豪。

当该异想体变得“焦虑”或“多疑”时，她的性格与行为会在2-4天内发生剧变。此症状类似于“分离性障碍”（注：歇斯底里症）

这个异想体的善恶价值观过于绝对。据调查，当人们对她信仰中的“邪恶存在”抱有疑问时，她便会化身为“恶”来物理否定一切猜疑。

在“愤怒”的行为结束之后，她不会留有当时的记忆。所以也没必要刻意提醒她干了些什么。

员工代号M4032：那么，你今天感觉如何？
魔法少女：超棒~！这里很安静，也很和平。和平可重要了，这意味着再也没有坏蛋窜来窜去了，对吧？

员工代号M4032：你看起来心情不大好呢？
魔法少女：还好吧，世界依旧很和平...这里也是...（该异想体沉默了）
（省略）
员工代号M4032：嘿，你还好吗？
魔法少女：为什么这里还是那么和平啊！我可是为了打败坏蛋而诞生的！这可恶的世界根本就不需要我的存在，是不是啊！喂，我有告诉过你我是一个魔法少女吗？我明明是被选中的救世主，为世界带来和平的人！可是今天，这里还是这么安静！实在是太安静了！...（该异想体不断自言自语着令人费解的话）}

（该异想体持续表现出狂躁和强迫症的症状，她甚至没有注意到进入收容单元的员工。）
魔法少女：世界划分为正义与邪恶两派，而我站在正义这边！如果我是个好人，这里就肯定有坏蛋存在！如果没有坏蛋，那我的存在还有什么意义！如果这样的话谁来拯救世界啊啊啊啊！！！
在这些症状出现之后，我们连续3天为她注射了大剂量的镇静剂。

访谈记录S3-4921 <警告>该文档仅向3级以上员工开放。
这是一份████的音频记录，事件发生在████，该异想体使用收容单元内的电话联系到了一位紧急反应部的员工。
魔法少女：（抽泣声）
员工：这里是紧急反应部门，请表明你的身份。
魔法少女：我...是我干的...有人...死在了我身边...我的手上...沾着他们的血...我...是我毁了这一切...我辜负了那些善良的人们...可是我...可是我什么都不记得了...什么都...
员工：到底发生了什么？
魔法少女：我不知道...他们就这样不动了...到处都是...血...对不起...我真的很对不起...
（省略）

随后我们在该异想体的收容单元内发现了三具员工的尸体，这些员工是被派来预防潜在事故的。再后来，魔法少女失去了对这整件事的记忆。"
Observation_level = "Ⅰ. 成功率 + 5%Ⅱ. 工作速度 + 3Ⅲ. 成功率 + 3%、解锁E.G.O饰品Ⅳ. 工作速度 + 5、解锁E.G.O武器、护甲"
flavour_text = Array[String](["“魔法少女”是所有异想体中表现得最活跃，最欢快的。但实际上她可能不止如此。", "迄今为止，“魔法少女”看起来对我们很友善，但仍需谨慎对待她。", "“魔法少女”的潜在威胁众所周知，因此请时刻对她保持警惕。", "事实上，“和平”并不是“魔法少女”所期待的结果。", "“魔法少女”正哼着小调，凝望窗外，看起来心情很不错。", "“魔法少女”用一个灿烂的微笑迎接刚进收容单元工作的员工。", "魔法少女”显然很高兴看见员工。", "“魔法少女”正得意地向员工讲述她一个人放倒三个坏蛋的故事。", "员工静静听着“魔法少女”的故事。尽管这些故事已经被她讲了好多好多遍了，但她完全讲不腻。", "“魔法少女”讲到曾经有个坏人在她的引导下洗心革面。员工赞赏了她，她笑得可开心了。", "“魔法少女”还想再说说世界是如何因为她而变得更加和平的。", "她的“魔法战靴”有时敲击在一起，发出欢快的声音。", "她脖子上的“魔法首饰”在灯光下闪闪发亮。", "她那华丽的“魔法蕾丝裙”正充满活力地摆动着。", "在念着自己的“变身魔咒”时，她突然开心地放声大笑。", "“魔法少女”对员工谈起了“职责”，她低声说道自己的职责是十分重要而神秘的。", "“魔法少女”对员工谈起了“正义”，她低声说自己的工作本身即代表着正义。", "当员工走进收容单元时，“魔法少女”正忧郁地低声细语。", "当员工走进收容单元时，“魔法少女”正忧郁地低声细语。", "不像之前，这次“魔法少女”没有看向刚进入收容单元的员工。", "员工靠近“魔法少女”检查她的状态。“和平正在逐渐减弱...”她喃喃自语。", "她嘟哝着“今天也是个好天气呢...可我觉得这一点儿都不好...”", "她的“魔法战靴”轻轻敲击地面，打破了收容单元的寂静。", "她的眼神飘忽不定，脸上挂着沉闷的苦笑。", "“魔法少女”神情愤恨地盯着员工，嘴上喃喃着含糊不清的话语。久未打理的头发略显松散。", "“魔法少女”的眼中充满憎恨。此时的她已不再是个“女孩”。", "不再是魔法少女的“憎恶女王”，正用充满杀意的眼神紧紧盯着员工。", "“憎恶女王”发现员工想要麻醉她，于是愤怒地发起了进攻。", "“憎恶女王”尖锐的毒牙贯穿了员工的肩膀。", "“憎恶女王”把员工的尸体甩在一边，冲出了收容单元。它在寻找下一个受害者。", "断气之前，员工试图拼尽全力说服“憎恶女王”。可它早已听不进任何东西。"])
other_info = "憎恶女王（O-01-04）是一个人形异想体，她是魔法少女之一。憎恶女王有着一个年轻少女的外表，她的皮肤相当白皙，长有一头淡蓝色的秀发和一对黄色的眼睛，有着日本卡通风格的大眼睛。她的头发上系有一颗黑底粉边的心形发饰，身穿一件粉色和白色的蕾丝裙，脖子上系着一个粉色的蝴蝶结，下身则穿着白丝和一双粉色的小鞋。

该异想体原型为塔罗牌中的小阿卡纳，圣杯皇后（此段摘录于边狱巴士wiki）
LCE等级推测为W-05左右
罪孽属性为嫉妒，暴怒

憎恶女王的身旁漂浮着一根“魔法棒”，一根白粉相间的细棒连接着一个粉色的五芒星和一颗淡蓝色的爱心。五芒星是中空的，勾勒出一颗爱心的图案，它的两侧各有一个白色的小翅膀，它们会随着憎恶女王的动作而上下摆动。

观察等级3级前，该异想体的名称为“魔法少女”，观察等级3及以上时会更改为“憎恶女王”。

[center]
[table=2]
[cell border=#ffffa1]基础工作速度[/cell][cell border=#ffffa1]工作冷却[/cell]
[cell border=#ffffa1]0.3[/cell][cell border=#ffffa1]15[/cell]
[/table]
[/center]

[img]res://img/Magic-1.webp[color=red]
收容单元监控画面[/color]

特殊能力
憎恶女王会根据当前的计数器来影响员工的工作效果：

计数器为2时（满格），为工作结束的员工完全恢复精神值和生命值。
计数器为1时，它会进入歇斯底里状态，此时所有类型的工作基础成功率都会减少20%（在工作期间因为其他原因扣除计数时，该效果会即时生效），在该状态下产出16个以上PE-BOX时，计数器加一，反之则计数器减少。
因管理须知Ⅵ可知，憎恶女王在歇斯底里状态时可以通过工作结果为优来增加，因此可以通过“卡融毁”来忽略歇斯底里状态带来的成功率减益影响，即：对憎恶女王工作期间，在已经或接近产出16个PE-BOX时触发融毁，此时憎恶女王的计数器减少，但因为工作结果为优（产出16个及以上PE-BOX），憎恶女王的计数器会立即加一，由此避免工作成功率降低的风险。

在每天的第一次触发 10 级融毁警报后（融毁警报最高为10级），再次触发10级融毁警报不会触发憎恶女王的第二条管理须知。因为此时融毁等级不会再增加，固定为 10 级，“先前的融毁等级”一说法不再成立。

处决弹击杀的职员在满足憎恶女王第二条管理须知的要求的同时，不会触发T-01-75尸山等因为职员死亡而减少计数器的效果。"
other_info_act = "出逃信息
出逃的“憎恶女王”的生命值为1200，基础移动速度为3单位，且拥有2种出逃形态。人形态的憎恶女王不会让员工受到恐惧伤害，但蛇形态会。
[center]
[table=1]
[cell border=#ffffa1]
第一种：人形态

憎恶女王在设施内发生二级警报时，会立刻随机传送至一个存在出逃异想体的房间以帮助员工镇压出逃的异想体。此时的憎恶女王无法被员工选择为镇压目标，但依旧会受到部分员工武器的误伤，且会在所有出逃的异想体都被镇压后自己回到收容室。

人形态的憎恶女王有三种攻击模式：

憎恶女王摇动魔杖，释放出一颗星星子弹，星星子弹会对击中的第一名异想体造成13-15点侵蚀伤害，且会为子弹经过的所有职员回复13-15点生命值和精神值。
憎恶女王比出一个射击的姿势，画出一个小型的魔法阵并进行短暂的蓄力，然后魔法阵里的能量会爆炸，对较大范围内所有的敌方单位造成80-120点侵蚀伤害，且为处在爆炸范围内的所有职员回复40-60点生命值和精神值。这个技能初始冷却时间为12-16秒，之后为8-12秒。
憎恶女王说出一系列的中二台词并将法杖放在身前蓄力，在法杖的前面出现三道魔法阵时，激光会从第三条魔法阵内射出，可以穿透房间。激光会对处于其中的所有敌方单位每0.5秒造成一次12-15点侵蚀伤害，且会为处在其中的员工每0.5秒回复4-5点生命值和7-8点精神值。激光会在持续时间的一半后增强，伤害增加至15-18点。激光共持续约10秒，且只有激光有伤害判定而魔法阵没有，憎恶女王会在释放完激光后脱力5-8秒，此时的憎恶女王无法移动也无法攻击。在该技能的动画播放期间内，憎恶女王将短暂地无法被选中作为目标并进入无敌状态。该技能的初始冷却时间为30-35秒，之后为20-25秒。
如果人形态的憎恶女王在未进入歇斯底里状态的前提下生命值归零，则她会在播放死亡动画时为设施内所有存活的职员全额回复生命值和精神值。
[/cell]
[cell border=#ffffa1]
第二种：蛇形态

如果憎恶女王在帮助镇压时，设施内存活职员的死亡率超过了20%，则憎恶女王会陷入歇斯底里状态并跪倒在原地，不会移动也不会攻击。这个状态会持续25-30秒，主管可以指派员工前去镇压该状态的憎恶女王。如果在这段时间内憎恶女王没有被镇压，则憎恶女王会变化为蛇形态，被算作出逃且会立刻给予周围员工一次恐惧伤害判定。如果憎恶女王是因为计数器归零出逃，则憎恶女王出逃时就直接是蛇形态。蛇形态的憎恶女王会在设施内随意的游荡，并对一切单位发起攻击。

蛇形态的憎恶女王有两种攻击模式：

憎恶女王会在游荡一段时间且没遇到攻击目标时进行传送，传送地点优先选择员工的聚集地，且传送目标不能是在电梯间内站定的员工。如果10-15秒的冷却时间结束，或是憎恶女王的生命值降低到了70%，40%，10%且不在进行激光攻击，则她会立刻进行一次传送。传送会对憎恶女王魔法阵光圈周围的所有员工造成20-26点侵蚀伤害。有时，“憎恶女王”会瞬移数次才会停下并正常地移动。
憎恶女王会在房间里有任何单位时使用这种攻击。憎恶女王会昂起头，对目标所在的方向进行蓄力。蓄力3-5秒后，憎恶女王将会发射一道能够穿透房间的激光，且会一直延伸到屏幕外。激光会降低处于其中的所有单位50%的移动速度，且会对它们每0.5秒造成一次4-6点侵蚀伤害，并在约3秒后提升至6-8点侵蚀伤害，6.5秒后提升至8-10点侵蚀伤害，共持续约10秒。激光造成的每一次伤害都会为憎恶女王提供5-8点生命值回复。憎恶女王会在激光射完后脱力倒地5-7秒，并会在起身时立刻使用一次传送。如果憎恶女王的激光没能命中任何目标，则憎恶女王可能会突然停止激光攻击并进行传送。
如果在其移动期间有员工或异想体攻击了憎恶女王，那么憎恶女王发射激光的方向就会朝向这些攻击它的目标。

憎恶女王蛇形态时的传送会造成一个极其少见的bug，这个bug会使得憎恶女王单次传送造成极其高额的侵蚀伤害，即使是130勇气的笑靥护甲也会被立刻击杀。触发原因未知，但目前的测试结果是该bug只会在憎恶女王传送至走廊和电梯间边缘的时候出现，且出现概率极低，请各位主管不要过于担心。
[/cell]
[/table]
[table=1]
[cell border=#ffffa1]
[bgcolor=#ffff5c80]憎恶女王收容室内外随机出现的台词
[/bgcolor]
[/cell]
[cell border=#ffffa1]
收容室内，状态正常：
这里是什么地方呀？
当你陷入危险时，记得向我呼救噢！
我是...怎么到这里来的？
昨晚发生了什么...我不记得了...
你知道胜利意味着什么吗？哎嘿嘿~世界真是美好！
有什么需要尽管通知我！我可以帮上忙的！
[/cell]
[cell border=#ffffa1]
收容室内，歇斯底里：
你不再需要我了吗...
我到底为何而存在...
不要再吵了！我不想听！！！
轮到我了...吗？
我讨厌这个安静的地方，世界不可能这么和平...
我是被选中的...除了我还有谁能守护世界...
没有黑暗就没有光明，我在这里根本没有意义...
有人告诉我，世界上已经没有坏蛋了，这是真的吗...
[/cell]
[cell border=#ffffa1]
主动出逃帮助镇压时：
交给我吧！
以爱与正义之名，魔法少女❤——闪亮登场！！！
帮助镇压时遭遇TETH级异想体：
小菜一碟！
别担心！我会助你一臂之力的！
解决这些小坏蛋不费吹灰之力！
[/cell]
[cell border=#ffffa1]
帮助镇压时遭遇HE级异想体：
呼，好像有点麻烦了！
我必须做点什么！
[/cell]
[cell border=#ffffa1]
帮助镇压时遭遇WAW级异想体：
异界...？这里也充满了魔法吗？
前辈们做不到的事，我可以做到！
[/cell]
[cell border=#ffffa1]
帮助镇压时遭遇ALEPH级异想体：
大家！快离开这里！
即使牺牲自己，我也要守护大家！
好...好强...！但是，哪怕只有我一个人，我也绝不会逃跑的！！！
[/cell]
[cell border=#ffffa1]
帮助镇压时遭遇贪婪女王：
前辈...对不起！我必须阻止您！
贪婪女王被镇压：
如果，我是在外面遇见前辈您的话...我很可能已经死了...
[/cell]
[cell border=#ffffa1]
帮助镇压时遭遇绝望骑士：
就连您...也被吞噬了...这是我们永远摆脱不了的宿命吗...
绝望骑士被镇压：
您...已经竭尽全力了...但是...
[/cell]
[cell border=#ffffa1]
帮助镇压时生命值归零：
我会...为了每一个人...奋战到最后一刻...
[/cell]
[cell border=#ffffa1]
所有出逃的异想体都被镇压：
~\\(≧▽≦)/~耶！我们做到啦！
任何时候都可以向我求助噢~！
[/cell]
[cell border=#ffffa1]
帮助镇压时陷入歇斯底里状态：
太过分了...
这一切...都是谎言吗？
我保护不了大家...我做不到...我不能像她那样...
不...我和她是一样的...
啊啊啊！从我脑子里滚出去！！！
是时候...付出代价了...吗？
[/cell]
[cell border=#ffffa1]
射出星星子弹时的台词：
以爱的名义！
以正义之名！
[/cell]
[cell border=#ffffa1]
释放蓄力法阵时的奇怪台词：
魔法❤之力！！！
磅磅~滚粗！！！
[/cell]
[cell border=#ffffa1]
蓄力和释放阿卡纳光波斩时憎恶女王会按顺序说出的中二咏唱：
噢！蔚蓝的正义，深红的爱！
为了被命运吞没的人而战！
向光明宣誓！!
邪恶的坏蛋不能阻挡我们！!
爱之力量守护我们！！！
魔法❤之刃！！！
[/cell]
[/table]
[/center]
镇压建议
镇压“憎恶女王”的工作并不容易，因为其能力特性，想要在“憎恶女王”造成破坏之前将其镇压是较为困难的，其攻击范围广、攻击伤害高的特点又使得职员很难躲避“憎恶女王”的激光攻击。但因为“憎恶女王”出逃前的标志很明显（计数1，黑化或者融毁），使得主管有充足的时间集结员工并做出应对。因为蛇形态的“憎恶女王”可能会传送到员工聚集地而导致其血量快速下降，这可能会使“憎恶女王”在员工聚集地里来回传送导致低侵蚀抗性的员工死亡，请主管及时的为员工添加反侵蚀力场盾，月光女神的ego在镇压战中也能起到较大的作用，

因为“憎恶女王”的激光持续伤害较高且会为它回复生命值，因而让任何员工处于激光范围内都是十分不明智的。“憎恶女王”在激光开始蓄力时会有较长且明显的蓄力前摇，且开始蓄力后就不会转向，只要主管在这时候把所有的员工移到它的背后就能有效避免激光的伤害。此时就是对“憎恶女王”造成伤害的最佳时机。

因为“憎恶女王”脱力结束后可能会立刻传送到原地造成两次伤害，请主管及时为员工提供反侵蚀力场盾。

不用担心文职可能会为“憎恶女王”提供过多的回复，文职在激光里会被瞬间蒸发，但激光覆盖范围极大，可能会造成大范围的文职伤亡，主管可能需要担心大范围文职伤亡造成的连锁反应。提前用处决子弹将激光范围内的文职人员全部处决会是个不错的选择。

如果主管当前的首要目标并不是进行工作而是处理混乱的出逃场面，且主管已经处理掉了文职，则人形态的憎恶女王提供的回复和伤害都能对主管的镇压工作起到极大的帮助。"
