[resource]
script = ExtResource("1_hxuiw")
lyc = "[00:00.00]Gone Angels - Mili
[00:02.83]Ah
[00:07.87]La-la-la-la-la-la-la
[00:10.59]La
[00:12.97]Look one by one
[00:15.08]The pages remind me you'll always be a villain
[00:20.46]For you angels have fallen
[00:24.16]Now they're gone
[00:25.38]See
[00:25.91]Now they're gone
[00:27.44]Forever gone
[00:29.22]From the hell that served as my one and only home
[00:35.31]Though it may hurt today
[00:37.15]Tomorrow I'll be heading my way
[00:43.41]I tried I tried
[00:47.58]What did we expect
[00:50.22]My dearest friend
[00:52.40]Tell me when we shall make it end
[00:57.96]So let me take your hand
[00:59.93]Like one of those madmen
[01:01.66]Tip tappity tappity tap
[01:03.44]Dance our last dance
[01:04.97]Sing
[01:05.24]Ta ta-li-la lu-li-la-tu
[01:07.18]La tu-la-li la-lu-li-lu
[01:09.03]Spinning vinyl opera
[01:11.62]Lascia ch'io pianga
[01:12.85]Longing for this moment
[01:15.01]Mia cruda sorte
[01:16.51]Brewing all this hatred
[01:18.69]E che sospiri
[01:20.17]So I have a reason
[01:22.28]La libertà
[01:23.82]Reason to see you dead
[01:27.72]Don't you worry
[01:30.31]I saved a spot for you in recycle bin
[01:34.70]Your neighbouring addresses point to the books you burned
[01:39.54]Stop now one by one
[01:42.22]Your desires convince me you've always been a human
[01:47.75]For you the shelves have fallen
[01:50.97]Now they're gone
[01:52.64]See
[01:53.15]Now they're gone
[01:54.62]Forever gone
[01:56.47]From the stage that allowed us our one and only dreams
[02:02.56]What's more to say
[02:04.38]Pain always catches up to those who chooses to stay
[02:09.99]Though it may hurt today
[02:11.78]Tomorrow I'll be heading my way
"
metadata/_custom_type_script = "uid://5npuf8ahi7vt"
