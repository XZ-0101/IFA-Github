[resource]
script = ExtResource("1_jqq17")
lyc = "[00:00.70][color=#dc153f]Rendezvous - Mili
[00:01.05][color=#dc153f]Lyrics by：Cassie Wei
[00:01.79][color=#dc153f]Composed by：Yamato Kasai/Cassie Wei
[00:09.60][color=#dc153f]If you're gonna say
[00:11.19][color=#dc153f]That life was meant to be wasted wasted away
[00:16.54][color=#dc153f]Then why are you so desperate
[00:20.15][color=#dc153f]In this heated heated debate?
[00:24.06][color=#dc153f]If you're gonna stay afloat
[00:26.62][color=#dc153f]Claim drifting is the only only way
[00:31.06][color=#dc153f]Then why are you so desperate for control?
[00:35.70][color=#dc153f]Chains covered by fancy clothes
[00:40.36][color=#293b95]Again and again I sighed
[00:43.96][color=#293b95]Again and again I was silent
[00:47.57][color=#293b95]Again and again closed my eyes
[00:51.10][color=#dc153f]Nauseating light
[00:54.82][color=#293b95]Again and again I climbed
[00:58.45][color=#293b95]Again and again I have fallen
[01:02.06][color=#293b95]Again and again I ignored
[01:05.66][color=#dc153f]Voices inside
[01:07.63][color=#dc153f]The staircase slips and fades
[01:10.45][color=#dc153f]From the elevator you smile and wave
[01:24.11][color=#dc153f]If you're gonna say
[01:25.78][color=#dc153f]That we were results of unintended unintended fate
[01:30.98][color=#dc153f]Then why is it that I always
[01:34.12][color=#dc153f]Notice the silhouette the silhouette you display?
[01:38.62][color=#dc153f]If you're gonna stay buoyant
[01:41.15][color=#dc153f]Claim drifting is the only only way
[01:45.65][color=#dc153f]Then why is it that we always
[01:49.24][color=#dc153f]End up returning to this place?
[01:52.36][color=#dc153f]A spontaneous rendezvous
[01:59.74][color=#dc153f]Inhale the perfume on your neck
[02:03.53][color=#dc153f]Leaving scratches on my back
[02:06.82][color=#dc153f]One more time
[02:09.41][color=#293b95]Again and again I sighed
[02:12.94][color=#293b95]Again and again I was silent
[02:16.47][color=#293b95]Again and again closed my eyes
[02:20.10][color=#dc153f]Nauseating light
[02:23.80][color=#293b95]Again and again I climbed
[02:27.37][color=#293b95]Again and again I have fallen
[02:31.11][color=#293b95]Again and again I learned
[02:34.71][color=#dc153f]That my bloodied knuckles gave me comfort
[02:40.24][color=#dc153f]Even with all this resentment and anger
[02:45.07][color=#dc153f]It's still much better than feeling nothing at all
[02:53.05][color=#293b95]Again and again I was hurt
[02:56.47][color=#293b95]Again and again irritated
[03:00.15][color=#293b95]Again and again reaching out
[03:03.22][color=#dc153f]To the alluring light
[03:07.46][color=#293b95]Again and again I thought
[03:11.14][color=#293b95]Again and again I discovered
[03:14.69][color=#293b95]Again and again I felt more like myself"
