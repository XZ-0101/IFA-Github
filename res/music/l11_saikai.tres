[resource]
script = ExtResource("1_dd7jw")
lyc = "[00:00.61]SAIKAI - Mili
[00:00.95]Lyrics by：Cassie Wei
[00:01.65]Composed by：Cassie Wei/Yamato Kasai
[00:30.68]When I was young and lost
[00:37.49]You showed up and had my doors unlocked
[00:45.14]Like threads petals unfold
[00:51.45]A red kawara-nadeshiko（カワラナデシコ）
[00:59.24]You have shown me that I am still capable of caring for someone else
[01:14.25]That I still bare the same innocence inside
[01:26.97]Cause now I know that
[01:29.18]Pain cannot define the past
[01:32.36]We are built to overcome endless mishaps
[01:37.19]You know it is not so bad
[01:41.48]When you are with me
[01:43.68]Cherish as long as we last
[01:47.04]Cause S is not for sayonara（さよなら）
[01:52.44]Let memories play back
[02:23.38]I knew I must step up
[02:30.08]You deserve the world and more
[02:37.82]The truth is that you'd rather
[02:44.10]Spend our limited time together
[02:51.89]Protection alone is not enough
[02:59.63]Providing cannot fill an empty cup thirsting for love
[03:10.54]I questioned myself a lot-
[03:43.85][color=red]What do I know about love?
[03:46.95][color=red]How can I recreate what I've never had?
[03:51.91][color=red]All I know is that I must keep you thriving
[03:58.26][color=red]If nutrients are what you lack
[04:01.49][color=red]I will water you with every drop of blood I have
[04:10.53][color=red]But now I know that
[04:12.73][color=red]Sacrifice is the easy path
[04:16.11][color=red]My absence cannot ever change the fact
[04:20.89][color=red]I wanted the very best for you believe me
[04:27.22][color=red]Our threads in red can never be cut
[04:30.64][color=red]And S is not for sayonara（さよなら）
[04:36.07][color=red]Will you forgive me at last?"
metadata/_custom_type_script = "uid://5npuf8ahi7vt"
