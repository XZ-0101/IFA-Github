[sub_resource type="GDScript" id="GDScript_h5o0q"]
script/source = "extends Control
@export var deck_array:Array[deck_box]
@export var ind:int=0
var pool:Array[deck_box]

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if LittleGameCtrl.now_level==LittleGameCtrl.max_level:
		var a = preload(\"res://little_game/over.tscn\")
		LittleGameCtrl.over_mode=0
		jumper.jump_to_without_await(a)
	else :
		jumper.hide_()
	if LittleGameCtrl.max_level <=5:
		pool=LittleGameCtrl.deck_pool
	if LittleGameCtrl.max_level >5 and LittleGameCtrl.max_level <=10:
		pool=LittleGameCtrl.h_deck_pool
	if LittleGameCtrl.max_level>10:
		pool=LittleGameCtrl.nm_deck_pool
	for i in range(0,3):
		deck_array.append(pool.pick_random())
	$level.text=str(LittleGameCtrl.now_level)+\"/\"+str(LittleGameCtrl.max_level)
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	$Control5.visible=LittleGameCtrl.panic
	
	$ind.text=str(ind+1)
	$Control/deck.deck=deck_array[ind]
	$Control/deck.load_me()
	pass


func _on_right_button_down() -> void:
	$Control/Anima.seek(0.0)
	$Control/Anima.play(\"new_animation\")
	if ind !=2:
		ind+=1
	else :
		ind=0
	
	pass # Replace with function body.


func _on_left_button_down() -> void:
	$Control/Anima.seek(0.0)
	$Control/Anima.play(\"new_animation\")
	if ind !=0:
		ind-=1
	else :
		ind=2
	
	pass # Replace with function body.


func _on_audio_stream_player_finished() -> void:
	$AudioStreamPlayer.play()
	pass # Replace with function body.
"

