[sub_resource type="GDScript" id="GDScript_o2wo4"]
script/source = "extends TextureButton
@export var q:question
@export var t :Array[Texture2D]
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func show_():
	if q.with_fight:
		$TextureRect.texture=t[1]
	else :
		$TextureRect.texture=t[0]

func _on_button_down() -> void:
	var a=preload(\"res://little_game/control.tscn\")
	
	LittleGameCtrl.now_point+=1
	LittleGameCtrl.now_q=q
	jumper.show_()
	jumper.jump_to(a)
	
	pass # Replace with function body.
"

