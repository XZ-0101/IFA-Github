[sub_resource type="Resource" id="Resource_4d71a"]
script = ExtResource("2_a054l")
name_ = "为何我要无视他，明明他很痛苦啊"
"结果" = "那是一首我曾经会唱的歌，将自己置于高台上，看！我多么光彩夺目！$s底下显得多么黯淡，所以细节都藏在了阴影中，包括台下失败者是表情。$s都太做作了，不是吗？"
metadata/_custom_type_script = "uid://d33or61wn0aky"

[sub_resource type="Resource" id="Resource_nlaup"]
script = ExtResource("2_a054l")
name_ = "你说的对…"
"结果" = "*滋滋*$s大姐姐！是吗？$s你曾经是这样的人吗？还记得那只小猫吗，你为它哭了整整一个晚上…"
metadata/_custom_type_script = "uid://d33or61wn0aky"

