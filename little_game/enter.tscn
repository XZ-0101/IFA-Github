[sub_resource type="GDScript" id="GDScript_ygh6a"]
script/source = "extends Control

@export var useful_gift_arr_:Array[jumper_class]
@export var deck_pool_:Array[deck_box]
@export var hard_deck_pool_:Array[deck_box]
@export var nm_deck_pool_:Array[deck_box]
@export var skill_dic:Dictionary[int,skill_arr_]={
	

}
var d_skill_arr:Array[skill_lt]
@export var d_gift_eff_arr:Array[gift_value]

var ml:int=5
var lgc=LittleGameCtrl
var skill_ind:int=0
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	MusicAll.get_child(1).get_child(0).button_pressed=true
	jumper.hide_()
	
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_button_button_down() -> void:
	lgc.gift_array.clear()
	lgc.gift_array.append(load(\"res://little_game/gift/bstt-g.tres\"))
	lgc.deck_pool=deck_pool_
	lgc.h_deck_pool=hard_deck_pool_
	lgc.nm_deck_pool=nm_deck_pool_
	lgc.useful_gift_arr=useful_gift_arr_
	d_skill_arr=skill_dic.get(skill_ind).skill_arr
	
	lgc.skill_arr_a=d_skill_arr.duplicate()
	LittleGameFight.skill_arr=d_skill_arr.duplicate()
	lgc.in_fight=false
	LittleGameFight.gift_eff_arr=d_gift_eff_arr
	lgc.value_array[0]=0
	lgc.value_array[1]=0
	lgc.value_array[2]=0
	lgc.value_array[3]=0
	lgc.hp=30
	lgc.n_hp=30
	lgc.sp=30
	lgc.n_sp=30
	lgc.max_level=ml
	lgc.now_level=0
	lgc.max_point=0
	lgc.now_point=0
	jumper.show_()
	Loading.load_to(\"res://little_game/choose_deck.tscn\",1)
	await Loading.load_over
	get_tree().change_scene_to_packed(Get.going_to_load_screen)
	
	pass # Replace with function body.





func _on_button_2_button_down() -> void:
	Loading.load_to(\"res://screen/收藏夹.tscn\",1)
	await Loading.load_over
	Get.jumped_list.append(Get.going_to_load_screen)
	get_tree().change_scene_to_packed(Get.going_to_load_screen)
	pass # Replace with function body.


func _on_option_button_item_selected(index: int) -> void:
	match index:
		0:
			ml=5
		1:
			ml=10
		2:
			ml=15
	pass # Replace with function body.


func _on_option_button_2_item_selected(index: int) -> void:
	skill_ind=index
	pass # Replace with function body.


func _on_help_button_down() -> void:
	$Window2.popup()
	pass # Replace with function body.
"

