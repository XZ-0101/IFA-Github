[ext_resource type="Script" uid="uid://5npuf8ahi7vt" path="res://script/song_word.gd" id="1_arbyr"]

[resource]
script = ExtResource("1_arbyr")
lyc = "[00:00.00][color=#8c384e]狩猎结束！[/color]
[00:07.39][color=#8c384e]把你们统统解体！[/color]
[00:14.78][color=#8c384e]我爱恨就恨！我恨所有那该死的家族，你们，还有券券！[/color]
[00:22.17][color=#8c384e]烦死了，烦死了啊！你们和券券，全都烦死了！！！[/color]
[00:29.56][color=#8c384e]怎么，打不中吗？[/color]
[00:36.95][color=#8c384e]连跟我对视的资格都没有的东西，哪来的胆子。[/color]
[00:44.34][color=#8c384e]那种程度，连我衣角都碰不到。[/color]
[00:51.73][color=#8c384e]我像狗一样摸爬滚打了几十年，你们却想让这一切都泡汤？[/color]
[00:59.12][color=#8c384e]放你娘的狗屁！我，伯纳特利家族的瓦伦希娜……！才不是该被困在这破地方的人！[/color]
[01:06.51][color=#8c384e]狩猎结束！[/color]
[01:13.90][color=#8c384e]把你们统统解体！[/color]
[01:21.29][color=#8c384e]我爱恨就恨！我恨所有那该死的家族，你们，还有券券！[/color]
[01:28.68][color=#8c384e]烦死了，烦死了啊！你们和券券，全都烦死了！！！[/color]
[01:36.07][color=#8c384e]怎么，打不中吗？[/color]
[01:43.46][color=#8c384e]连跟我对视的资格都没有的东西，哪来的胆子。[/color]
[01:50.85][color=#8c384e]那种程度，连我衣角都碰不到。[/color]
