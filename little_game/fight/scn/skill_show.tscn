[sub_resource type="GDScript" id="GDScript_rk3vd"]
resource_name = "skill_show"
script/source = "extends Control
@export var skill:skill_lt
@export var mode:int
signal coin_over
signal coin_out(is_f:bool)
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_window_close_requested() -> void:
	$Window.hide()
	pass # Replace with function body.


func _on_button_button_down() -> void:
	$Window.popup()
	pass # Replace with function body.

func show_it():
	remove_coin()
#region value
	var skill_icon = $img/skill_icon
	var labelI_color=$img/label_panel
	var labelII_color=$img/label_panelII
	var coin = $coin
	var name_=$label/name
	var base=$label/base
	var change=$label/change
	var at=$HBoxContainer/at
	var def=$HBoxContainer2/def
	var de=$Window/RichTextLabel
#endregion
	
	name_.call_deferred(\"_request_adjust\")
	
	skill_icon.texture=skill.icon
	labelII_color.modulate=skill.sin_color
	labelI_color.modulate=skill.sin_color
	name_.text=skill.name_
	base.text=str(skill.base_point)
	
	change.text = str(skill.change_Point) if  skill.change_Point<0 else \"+\"+str(skill.change_Point)
	at.text=str(skill.at)
	def.text =str(skill.def)
	for i in skill.coin_n:
		coin.add_child(creat_coin())
	if mode!=1:
		
		var text1=\"技能效果\\n\"
		for i in skill.description:
			text1+=i+'\\n'
		var text2=\"标签\\n\"
		for i in skill.type:
			text2+=\"-\"+i+\"\\n\"
		de.text=text1+\"\\n\"+text2
	if mode ==1:
		$Button.hide()
	if mode==2:
		$TextureRect.show()
	return

func creat_coin(coin:int=0):
	var back=preload(\"res://little_game/fight/img/ui/nor_coin_back.tres\")
	var front=preload(\"res://little_game/fight/img/ui/nor_coin_front.tres\")
	var nor=preload(\"res://little_game/fight/img/ui/nor_coin.tres\")
	var icon=TextureRect.new()
	icon.custom_minimum_size=Vector2(30,30)
	icon.expand_mode=TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode=TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	match coin:
		0:
			icon.texture=nor
		1:
			icon.texture=front
		2:
			icon.texture=back
	return icon

func coin_show(arr:Array[bool]):
	
	if arr.size()==skill.coin_n:
		for i in range(1, arr.size()+1):
			var c=creat_coin(1 if arr[i-1] else 2)
			if arr[i-1]:
				
				creat_p(c)
				$show/AudioStreamPlayer.play()
			else:
				$show/AudioStreamPlayer2.play()
			$coin.get_child(i-1).replace_by(c)
			$show/Timer.start()
			emit_signal(\"coin_out\",arr[i-1])
			await  $show/Timer.timeout
	emit_signal(\"coin_over\")
	
		
		

func creat_p(c):
	var p=preload(\"res://little_game/fight/scn/gpu_particles_2d.tscn\").instantiate() as GPUParticles2D
	c.add_child(p)
	p.emitting=true
	await p.finished
	p.queue_free()
	
func remove_coin():
	for i in $coin.get_children():
		i.queue_free()
"

