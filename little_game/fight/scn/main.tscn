resource_name = "fight_scn"
script/source = "extends Control
@export var enemy:enemy_lg
@export_category(\"赋值\")
@export var enemy_name:RichTextLabel
@export var enemy_hp_num_cent:RichTextLabel
@export var enemy_hp_pb:ProgressBar
@export var enemy_sp_num_cent:RichTextLabel
@export var enemy_sp_pb:ProgressBar
@export var hp_num_cent:RichTextLabel
@export var hp_pb:ProgressBar
@export var sp_num_cent:RichTextLabel
@export var sp_pb:ProgressBar
@export var buff:GridContainer
@export var enemy_buff:GridContainer
@export var enemy_skill:CenterContainer
@export var skill_act:HBoxContainer
@export var enemy_anima_node:Control
@export var our_anima_node:Control
var text:Array[String]
@export var value_get_text_array:Array[String]
var fight=LittleGameFight
var turn_num:int=0
var fake_turn_num:bool=true
var skill_show_path = preload(\"res://little_game/fight/scn/skill_show.tscn\")
var enemy_act_list:Array[String]
var choised_skill:skill_lt
var choised_skill_ind:int=0
var enemy_panic:bool=false
var is_panic:bool=false
var now:float
var now_m:music_class
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	LittleGameCtrl.in_fight=true
	jumper.hide_()
	enemy=LittleGameCtrl.now_f
	fight.enemy=enemy
	
	fight.Initialization()
	show_enemy_info()
	
	fight.updata_buff_info=updata_buff
	fight.enemy_anima=enemy_anima_node
	fight.self_anima=our_anima_node
	if fight.enemy.music:
		now_m=fight.enemy.music
	music_play()
	fight.do_it(\"fight_strat\")
	
	turn_start()
	pass # Replace with function body.
func turn_start():
	
	
	fight.true_turn_num+=1
	fight.turn_num+=1
	turn_num=fight.turn_num
	
	if fight.true_turn_num!=1:
		fight.Init_value()
	
	
	
	choised_skill_ind=0
	fight.do_it(\"turn_strat\")
	fake_turn_num=fight.true_turn_num!=fight.turn_num
	check_panic()
	check_die()
	if is_panic:
		panic_skill_give()
	else :
		give_card()
	
	if enemy_panic:
		enemy_panic_skill_give()
	else:
		enemy_act()
	if fight.enemy_hp>fight.enemy.hp:
		fight.enemy_hp=fight.enemy.hp
	if fight.fight_hp>fight.fight_hp_max:
		fight.fight_hp=fight.fight_hp_max

	if fight.enemy_sp>fight.enemy.sp:
		fight.enemy_sp=fight.enemy.sp
	if fight.fight_sp>fight.fight_sp_max:
		fight.fight_sp=fight.fight_sp_max
	

func give_card():
	assignment_skill(3,fight.skill_arr[3])
	if fight.skill_pool!=[]:
		var c1 =fight.skill_pool.pick_random()
		var c2= fight.skill_pool.pick_random()
		assignment_skill(1,c1)
		assignment_skill(2,c2)
	else:
		for i in randf_range(1,3):
			fight.add_skill_inpool(fight.skill_arr[0],0)
			
		for i in randf_range(1,2):
			fight.add_skill_inpool(fight.skill_arr[1],0)
			
		fight.add_skill_inpool(fight.skill_arr[2],0)
		give_card()
	skill_act.show()
	
func assignment_skill(which:int,skill:skill_lt):
	skill_act.get_child(which).skill=skill
	skill_act.get_child(which).read()

#region enemy_act
func enemy_act():
	if enemy_act_list:
		var now_act=enemy_act_list.front()
		
		enemy_give_card(now_act)
		enemy_act_list.erase(now_act)
		pass
	else:
		enemy_act_list=fight.enemy.action_play.duplicate()
		enemy_act()
	pass
func enemy_give_card(act:String):
	
	var act_list=act.split(\",\")
	match act_list[0]:
			\"r\":
				if fight.enemy_skill_pool!=[]:
					var c1 =fight.enemy_skill_pool.pick_random()
					ass_skill_enemy(c1)
					
				else:
					give_card_enemy_rmode()
					enemy_give_card(act)
					
			\"rp\":
				var num =randi_range(int(act_list[1]),int(act_list[2]))
				var sk=fight.enemy.skill_array[num]
				ass_skill_enemy(sk)
				
			\"p\":
				var sk=fight.enemy.skill_array[int(act_list[1])]
				ass_skill_enemy(sk)
	enemy_skill.show()

func ass_skill_enemy(c1:skill_lt):
	fight.now_enemy_skill=c1
	enemy_skill.get_child(0).skill=c1
	enemy_skill.get_child(0).show_it()
	fight.enemy_skill_pool.erase(c1)

func give_card_enemy_rmode():
	for i in fight.enemy.skill_array:
		print(\"give\",i.level)
		match i.level:
			1:
				fight.add_skill_inpool(i,1)
				fight.add_skill_inpool(i,1)
				fight.add_skill_inpool(i,1)
			2:
				fight.add_skill_inpool(i,1)
				fight.add_skill_inpool(i,1)
			3:
				fight.add_skill_inpool(i,1)
#endregion

func skill_down(ind:int):
	var skill_node=skill_act.get_child(ind+1)
	choised_skill=skill_node.skill
	choised_skill_ind=ind+1
	var jg=will_we_win(skill_node.skill,fight.now_enemy_skill)
	set_line_color(jg)
	pass
func skill_up():
	
	choised_skill_ind=0

# 投硬币函数
# 参数：coin_n - 硬币数量
#       p      - 每个硬币为正面的概率（建议范围 0.0~1.0）
# 返回：Array[bool] - 长度 = coin_n，true=正面，false=反面
func toss_coins(coin_n: int, p: float) -> Array[bool]:
	print(p)
	var p_ = clamp(p, 0.05, 0.95)
	var results: Array[bool] = []
	results.resize(coin_n)
	
	for i in range(coin_n):
		
		var n=randf()
		# randf() 返回 [0.0, 1.0) 的随机浮点数
		var is_positive = n < p_
		print(n,\" and \",p_)
		results[i] = is_positive
	
	return results

func set_line_color(jg:String):
	var color:Color
	match jg:
		\"绝对劣势\":
			color=Color(0.5,0,0)
		\"劣势\":
			color=Color(0.8,0,0)
		\"均势\":
			color=Color(0.5,0.5,0.5)
		\"优势\":
			color=Color(0.5,0.5,0)
		\"绝对优势\":
			color=Color(1,1,0)
	var a =skill_act.get_child(4) as Node2D  
	a.modulate=color

#region 
func will_we_win(skill: skill_lt, skill2: skill_lt) -> String:
	# 安全获取 SP 比例，避免除零
	var sp_raw = float(fight.fight_sp) / max(float(fight.fight_sp_max), 0.01)
	var esp_raw = float(fight.enemy_sp) / max(float(fight.enemy.sp), 0.01)
	var spc = clamp(sp_raw, 0.05, 0.95)
	var espc = clamp(esp_raw, 0.05, 0.95)
	
	# 获取点数分布
	var dist1 = _get_skill_distribution(skill, spc)
	var dist2 = _get_skill_distribution(skill2, espc)
	var points1 = dist1[0]
	var probs1 = dist1[1]
	var points2 = dist2[0]
	var probs2 = dist2[1]
	
	# 计算期望胜率：P(win) + 0.5 * P(tie)
	var win_prob = 0.0
	var tie_prob = 0.0
	for i in range(len(points1)):
		var p_i = probs1[i]
		var val_i = points1[i]
		for j in range(len(points2)):
			var p_j = probs2[j]
			if points2[j] < val_i:
				win_prob += p_i * p_j
			elif points2[j] == val_i:
				tie_prob += p_i * p_j
	var effective_prob = win_prob + tie_prob * 0.5
	
	# 五档判定（可根据游戏设计调整阈值）
	if effective_prob >= 0.9:
		return \"绝对优势\"
	elif effective_prob >= 0.6:
		return \"优势\"
	elif effective_prob >= 0.4:
		return \"均势\"
	elif effective_prob >= 0.1:
		return \"劣势\"
	else:
		return \"绝对劣势\"


# 辅助函数：根据技能和概率 p 计算点数分布
# 返回 Array[Array[float], Array[float]]，即 [点数列表, 概率列表]
func _get_skill_distribution(skill: skill_lt, p: float) -> Array:
	var n = skill.coin_n
	var base = skill.base_point
	var delta = skill.change_Point
	var points = []
	var probs = []

	# 边界情况：概率为 0 或 1（实际上 p 已被钳制在 0.05~0.95，但保留边界处理）
	if p == 0.0:
		probs.append(1.0)
		points.append(base)
		return [points, probs]
	if p == 1.0:
		probs.append(1.0)
		points.append(base + n * delta)
		return [points, probs]

	# 递推计算二项分布概率 P(X=k) 及对应点数
	var prob = pow(1.0 - p, n)   # P(X=0)
	probs.append(prob)
	points.append(base)

	for k in range(1, n + 1):
		# 递推公式：P(k) = P(k-1) * (n-k+1)/k * p/(1-p)
		prob = prob * (n - k + 1) / k * p / (1.0 - p)
		probs.append(prob)
		points.append(base + k * delta)

	return [points, probs]
#endregion

func _process(delta: float) -> void:
	update_info()
	var p =$AudioStreamPlayer
	var Typer=$CanvasLayer
	if p.playing:
		now=p.get_playback_position()
		
		Typer.time=seconds_to_time_str(snapped(now,0.1))
	pass
func seconds_to_time_str(seconds: float) -> String:
	# 处理负数和零
	if seconds <= 0:
		return \"00:00.0\"
	
	# 转换为十分之一秒（保留1位小数）
	var total_deciseconds = int(round(seconds * 10))  # 关键修改：改为 ×10
	var total_seconds = total_deciseconds / 10
	var decisecond = total_deciseconds % 10  # 获取十分之一秒位（0-9）
	
	var minutes = total_seconds / 60
	var remaining_seconds = total_seconds % 60
	
	# 格式化为2位分钟:2位秒.1位十分秒
	return \"%02d:%02d.%01d\" % [minutes, remaining_seconds, decisecond]

func truncate_to_one_decimal(value: float) -> float:
	return int(value * 10) / 10.0  # 改为保留1位小数


func check_panic():
	if is_panic:
		is_panic=false
		fight.fight_sp=fight.fight_sp_max/2
	if enemy_panic:
		enemy_panic=false
		fight.enemy_sp=fight.enemy.sp/2
	if fight.enemy_sp<=0:
		enemy_panic=true
	if fight.fight_sp<=0:
		is_panic=true
	

func panic_skill_give():
	assignment_skill(1,fight.skill_arr[4])
	assignment_skill(2,fight.skill_arr[4])
	assignment_skill(3,fight.skill_arr[4])
	skill_act.show()
	
func enemy_panic_skill_give():
	ass_skill_enemy(fight.enemy.panic_skill)
	enemy_skill.show()
	

func _on_button_button_down() -> void:
	$enemy/enemy_texture/Button/Popup.popup()
	pass # Replace with function body.

func show_enemy_info():
	var base=$\"enemy/enemy_texture/Button/Popup/Panel/enemy_info/基础\"
	var skill=$\"enemy/enemy_texture/Button/Popup/Panel/enemy_info/技能/sk\"
	var passive=$\"enemy/enemy_texture/Button/Popup/Panel/enemy_info/被动\"
	passive.text=\"\"
	for i in skill.get_children():
		i.queue_free()
	base.text=\"名字:{name}\\n[color=red]HP[/color]:{hp}\\n[color=cyan]SP[/color]:{sp}\\n-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-\\n\".format({\"name\":enemy.name_,\"hp\":str(enemy.hp),\"sp\":str(enemy.sp)})+enemy.description
	for i in enemy.passives:
		passive.text+=\"[color=white]{name}[/color]\\n{d}\\n-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-\\n\".format({\"name\":i.name_,\"d\":i.description})
	for i in enemy.skill_array:
		skill.add_child(build_skill_show(i))
	skill.add_child(build_skill_show(enemy.panic_skill,2))
	$enemy/enemy_texture.texture=enemy.img
	$enemy/VBoxContainer/base/VBoxContainer/enemy_name.text=enemy.name_

func build_skill_show(skill,mode_:int=0):
	var n=skill_show_path.instantiate()
	n.skill=skill
	n.mode=mode_
	n.show_it()
	return n
func update_info():
	var ehp=LittleGameFight.enemy.hp
	var nowehp=LittleGameFight.enemy_hp
	var esp=LittleGameFight.enemy.sp
	var nowesp=LittleGameFight.enemy_sp
	var hp=LittleGameFight.fight_hp_max
	var nowhp=LittleGameFight.fight_hp
	var sp=LittleGameFight.fight_sp_max
	var nowsp=LittleGameFight.fight_sp
	
	enemy_hp_num_cent.text=str(nowehp)+\"/\"+str(ehp)
	enemy_sp_num_cent.text=str(nowesp)+\"/\"+str(esp)
	enemy_hp_pb.max_value=ehp
	enemy_hp_pb.value=nowehp
	enemy_sp_pb.max_value=esp
	enemy_sp_pb.value=nowesp
	
	hp_num_cent.text=str(nowhp)+\"/\"+str(hp)
	sp_num_cent.text=str(nowsp)+\"/\"+str(sp)
	hp_pb.max_value=hp
	hp_pb.value=nowhp
	sp_pb.max_value=sp
	sp_pb.value=nowsp
	
	$TURN.text=\"TURN:\"+str(fight.turn_num) if not fake_turn_num else \"[color=red]TURN:\"+str(fight.turn_num)
	if choised_skill_ind!=0:
		skill_act.get_child(4).show()
		var posi1:Vector2
		posi1=skill_act.get_child(choised_skill_ind).global_position+Vector2(60,60)
		skill_act.get_child(4).update_curve(posi1,enemy_skill.global_position+Vector2(70,100))
	else:
		skill_act.get_child(4).hide()
	if enemy_panic:
		$enemy/enemy_texture/panic.show()
	else:
		$enemy/enemy_texture/panic.hide()
	if is_panic:
		$panic.show()
	else :
		$panic.hide()
	pass

func updata_buff():
	for i in buff.get_children()+enemy_buff.get_children():
		i.queue_free()
	for i in LittleGameFight.buff_pool:
		buff.add_child(buff_build(i))
	for i in LittleGameFight.enemy_buff_pool:
		enemy_buff.add_child(buff_build(i))
		
	
	pass
func buff_build(i):
	var b=preload(\"res://little_game/fight/scn/buff_show.tscn\")
	var buff_show=b.instantiate()
	buff_show.buff=i
	return buff_show
	
func _on_fight_start_button_down() -> void:
	fight.skill_pool.erase(choised_skill)
	start_point()
	pass # Replace with function body.

func start_point():
	if choised_skill_ind!=0:
		skill_act.hide()
		enemy_skill.hide()
		
		fight.now_skill=choised_skill
		var our_s=fight.now_skill
		var enemy_s=fight.now_enemy_skill
		fight.add_to_time_list(our_s.eff_arr.map(fight.eff_to_team_0))
		fight.add_to_time_list(enemy_s.eff_arr.map(fight.eff_to_team_1))
		fight.do_it(\"before_point\")
		var s1=fight.now_skill
		var s2=fight.now_enemy_skill
		var spc=float(fight.fight_sp) / max(float(fight.fight_sp_max), 0.01)
		var espc= float(fight.enemy_sp) / max(float(fight.enemy.sp), 0.01)
		
		
		var arr=toss_coins(s1.coin_n,spc)
		var arr2=toss_coins(s2.coin_n,espc)
		$Panel_point.show()
		$Panel_point.point(arr,s1,arr2,s2)
	pass

func _on_control_skill_choice(ind: int) -> void:
	if choised_skill_ind==ind+1:
		skill_up()
		pass
	else:
		skill_down(ind)
	pass # Replace with function body.


func _on_skill_mouse_entered() -> void:
	print(\"mouse in\")
	$enemy/enemy_texture.self_modulate=Color(1,1,1,0.5)
	pass # Replace with function body.


func _on_skill_mouse_exited() -> void:
	$enemy/enemy_texture.self_modulate=Color(1,1,1,1)
	pass # Replace with function body.


func _on_panel_point_point_over(who_win:int) -> void:
	fight.who_win=who_win
	if who_win==0:
		fight.enemy_sp-=5
		fight.fight_sp+=5
		fight.play_anima(\"text\",1,\"hit,5,sp\")
		fight.play_anima(\"text\",0,\"hel,5,sp\")
	if who_win==1:
		fight.fight_sp-=5
		fight.enemy_sp+=5
		fight.play_anima(\"text\",0,\"hit,5,sp\")
		fight.play_anima(\"text\",1,\"hel,5,sp\")
	await get_tree().create_timer(0.7).timeout
	if who_win!=2:
		use_skill()
	else :
		next_turn()
	pass # Replace with function body.

func use_skill():
	
	var our_s=fight.now_skill
	var enemy_s=fight.now_enemy_skill
	
	fight.do_it(\"before_under_hit\")
	fight.do_it(\"before_hit\")
	await get_tree().create_timer(0.5).timeout
	fight.hit(fight.who_win)
	
	if fight.who_win==0:
		var an=$enemy/AnimatedSprite2D as AnimatedSprite2D
		var an2=enemy_anima_node.get_child(0) as AnimationPlayer
		
		if \"防御\" in enemy_s.type:
			an2.play(\"3\")
			$sound/DefenseGuard.play()
		elif \"闪避\" in enemy_s.type and fight.hit_num_==0:
			an2.play(\"2\")
			$sound/DefensedVert.play()
		else:
			an2.play(\"1\")
			$sound/KaliSpecialVertHit.play()
		an.play(\"1\")
		
	else:
		if \"防御\" in our_s.type:
			fight.play_anima(\"self_d\",0,\"\")
			
		elif \"闪避\" in our_s.type and fight.hit_num_==0:
			fight.play_anima(\"self_v\",0,\"\")
		else:
			fight.play_anima(\"self_hit\",0,\"\")
	fight.do_it(\"after_under_hit\")
	fight.do_it(\"after_hit\")
	await get_tree().create_timer(1.5).timeout
	next_turn()
func next_turn():
	fight.do_it(\"turn_end\")
	turn_start()
func check_die():
	if fight.enemy_hp<=0:
		if fight.enemy.next_enemy:
			to_next_enemy()
		else:
			win()
	if fight.fight_hp<=0:
		lose()
	pass
func win():
	LittleGameCtrl.n_hp=fight.fight_hp
	LittleGameCtrl.sp=fight.fight_sp*2
	var i =fight.enemy
	if i.gift:
		if i.gift.get_gift:
			for i_ in i.gift.get_gift:
				
				if not i_ in LittleGameCtrl.gift_array:
					
				
				#
					LittleGameCtrl.gift_array.append(i_)
					text.append(\"你获得了[color=yellow]\"+i_.name_+\"[/color]\")

				

		if i.gift.add_valua!=0 :
			if i.gift.value_object>=4:
				if i.gift.value_object==4:
					LittleGameCtrl.n_hp+=i.gift.add_valua
					text.append(value_get_text_array[i.gift.value_object].format({\"n\":str(i.gift.add_valua)}))
				if i.gift.value_object==5:
					LittleGameCtrl.n_sp+=i.gift.add_valua
					text.append(value_get_text_array[i.gift.value_object].format({\"n\":str(i.gift.add_valua)}))
			else :
				LittleGameCtrl.value_array[i.gift.value_object]+=i.gift.add_valua
				text.append(value_get_text_array[i.gift.value_object].format({\"n\":str(LittleGameCtrl.value_array[i.gift.value_object])}))
		if i.gift.skill:
			if not i.gift.skill in LittleGameCtrl.skill_arr_a:
				LittleGameCtrl.skill_arr_a.append(i.gift.skill)
				text.append(\"你获得了[color=red]\"+i.gift.skill.name_+\"[/color]\")
		$win.show_(text)
	else:
		text.append(\"没有奖励\")
		$win.show_(text)
		
	pass

func lose():
	LittleGameCtrl.in_fight=false
	var a = preload(\"res://little_game/over.tscn\")
	LittleGameCtrl.over_mode=1
	jumper.jump_to_without_await(a)
func end():
	LittleGameCtrl.in_fight=false
	jumper.show_()
	jumper.jump_to(load(\"res://little_game/a_point.tscn\"))
	
	print(\"end\")
func music_play():
	if enemy.music or now_m:
		var music
		if not enemy.music:
			music=now_m
		else:
			music=enemy.music
		var Typer=$CanvasLayer
		$AudioStreamPlayer.stream=load(music.music_path)
		
		if music.ge_ci_path:
			if not music.ge_ci_path.begins_with(\"p\"):
				Typer.font=load(music.ge_ci_path).font
				Typer.wait=music.wait_time
				var dic =LoadTxt.load_to(music.ge_ci_path)
				Typer.dic=dic
			Typer.start=true
		$AudioStreamPlayer.play()


func _on_audio_stream_player_finished() -> void:
	var Typer=$CanvasLayer
	Typer.start=false
	music_play()
	pass # Replace with function body.
func to_next_enemy():
	
	var next =fight.enemy.next_enemy
	enemy=next
	fight.enemy=enemy
	fight.enemy_hp=enemy.hp
	fight.enemy_sp=roundi(float(enemy.sp)/2)
	fight.init_arr()
	show_enemy_info()
	
	fight.updata_buff_info=updata_buff
	fight.enemy_anima=enemy_anima_node
	fight.self_anima=our_anima_node
	music_play()
	
	fight.do_it(\"fight_strat\")
	turn_start()
"

