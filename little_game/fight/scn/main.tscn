[sub_resource type="GDScript" id="GDScript_66qcp"]
script/source = "extends Panel
@export var skill_show:Node
@export var skill_show2:Node
@export var skill_point:Node
@export var skill_point2:Node
@export var skill_point_num:Label
@export var skill_point_num2:Label
var s1:skill_lt
var s2:skill_lt
var p:int
var p2:int
signal point_over(who_win:int)
var can_next=false
var who_win:int
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func point(arr:Array[bool],skill:skill_lt,arr2:Array[bool],skill2:skill_lt):
	can_next=false
	$partic/GPUParticles2D.emitting=true
	skill_show.skill=skill
	skill_show2.skill=skill2
	s1=skill
	s2=skill2
	skill_show.show_it()
	skill_show2.show_it()
	skill_point.texture=skill.icon
	skill_point2.texture=skill2.icon
	skill_point_num.text=str(skill.base_point)
	skill_point_num2.text=str(skill2.base_point)
	p=skill.base_point
	p2=skill2.base_point
	$Timer.start()
	await  $Timer.timeout
	skill_show2.coin_show(arr2)
	await  skill_show2.coin_over
	
	$Timer.start()
	await  $Timer.timeout
	
	skill_show.coin_show(arr)
	await  skill_show.coin_over
	
	LittleGameFight.max_point=p
	LittleGameFight.enemy_max_point=p2
	LittleGameFight.do_it(\"when_point\")
	skill_point_num2.text=str(LittleGameFight.enemy_max_point)
	skill_point_num.text=str(LittleGameFight.max_point)
	if LittleGameFight.max_point == LittleGameFight.enemy_max_point:
		who_win=2
	if LittleGameFight.max_point > LittleGameFight.enemy_max_point:
		who_win=0
	if LittleGameFight.max_point < LittleGameFight.enemy_max_point:
		who_win=1
	$partic/GPUParticles2D.emitting=false
	$ParryAtk.play()
	$partic/GPUParticles2D2.emitting=true
	can_next=true
	
	
func _on_skill_coin_out(is_f:bool) -> void:
	if is_f:
		p2+=s2.change_Point
	skill_point_num2.text=str(p2)
	


func _on_skil2l_coin_out(is_f:bool) -> void:
	if is_f:
		p+=s1.change_Point
	skill_point_num.text=str(p)
	
func  _input(event: InputEvent) -> void:
	if can_next and event is InputEventMouseButton:
		can_next=false
		hide()
		emit_signal(\"point_over\",who_win)
"

