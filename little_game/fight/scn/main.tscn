script/source = "extends TextureRect


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
func shake_node(duration: float = 0.2, intensity: float = 10.0):
	var node=self
	var original_pos = node.position
	var tween = create_tween()
	var elapsed = 0.0
	var shake_step = 0.05   # 每0.05秒改变一次位置
	
	while elapsed < duration:
		var offset = Vector2(
			randf_range(-intensity, intensity),
			randf_range(-intensity, intensity)
		) * (1.0 - elapsed / duration)  # 逐渐减弱
		tween.tween_property(node, \"position\", original_pos + offset, shake_step)
		elapsed += shake_step
		# 等待前一个动画完成后再设置下一个（实际上 create_tween 会并行，这里简化）
		# 更精确的做法是用多个 tween 顺序执行，但简单的效果可以接受
	
	# 最后回到原位
	tween.tween_property(node, \"position\", original_pos, 0.1)
"

