[sub_resource type="GDScript" id="GDScript_j8kih"]
script/source = "extends Control

var jumper_array:Array[jumper_class]

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	
	if FileAccess.file_exists(\"user://LittleGame.tres\"):
		var p=load(\"user://LittleGame.tres\")
		LittleGameCtrl.got_gift_array=p.array
	for i in LittleGameCtrl.got_gift_array:
		var b =preload(\"res://screen/jumper_button.tscn\").instantiate()
		b.jumper=i
		$ScrollContainer3/VBoxContainer.add_child(b)
	
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	
	pass





func _on_button_4_button_down() -> void:
	#$Button4.hide()
	var r=shou_cang_jia.new()
	r.array=LittleGameCtrl.got_gift_array
	ResourceSaver.save(r,\"user://LittleGame.tres\")
	OS.alert(tr(\"已保存\"))
	pass # Replace with function body.
"

