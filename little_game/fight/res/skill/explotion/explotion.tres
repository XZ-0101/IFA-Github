[sub_resource type="Resource" id="Resource_6n6vu"]
script = ExtResource("1_rlshy")
code = "var buff=\"res://little_game/fight/res/buff/yingchang.tres\"
var p = Fight.get_buff_x_with_res(team, buff)
p = clampi(p, 0, 4)
now_skill.coin_n = 2 * p
now_skill.at += 10 * p
Fight.minus_buff_path(buff, team, p)"
exe_time = "before_point"
is_who = true
one_time = true
metadata/_custom_type_script = "uid://skro7sm8drh8"

[sub_resource type="Resource" id="Resource_ngti8"]
