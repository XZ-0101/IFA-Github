[resource]
script = ExtResource("2_tr0tv")
img = ExtResource("1_hs3s0")
name_ = "祈愿"
subject = "投稿-东朗-1"
"问题" = "在一片黑暗的空间内，天上传来撕裂声，像是某些东西被撕开了一样$s“那些……是星星吗？”我抬头望去，我透过裂缝看见了像是夜空一样的景色。$s这时一颗流星划过，我想起之前听说过当流星划过天空时许愿会成真。$s我也许个愿怎么样？"
item = Array[ExtResource("1_va532")]([SubResource("Resource_i0xia"), SubResource("Resource_f6nt7")])
metadata/_custom_type_script = "uid://cm1g2p3y1vl0v"
