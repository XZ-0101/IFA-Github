	Fight.minus_buff_path(\"res://little_game/fight/res/buff/totem.tres\",team,1)
if hp<=0:
	hp=hp_max
	Fight.add_buff_path(\"res://little_game/fight/res/buff/totem_used.tres\",1,team)

	Fight.add_buff_path(\"res://little_game/fight/res/buff/Regeneration-mc.tres\",5,team)
	Fight.add_buff_path(\"res://little_game/fight/res/buff/Fire_Resistance-mc.tres\",3,team)
	Fight.add_buff_path(\"res://little_game/fight/res/buff/absorption-mc.tres\",2,team)

	Fight.minus_buff_path(\"res://little_game/fight/res/buff/totem.tres\",team,1)
"
