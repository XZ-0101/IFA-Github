[sub_resource type="Resource" id="Resource_0wkv3"]
script = ExtResource("20_phqsb")
code = "Fight.add_buff_path(\"res://little_game/fight/res/buff/blood.tres\",1,get_enemy(team))
if Fight.get_buff_x_with_res(team,\"res://little_game/fight/res/enemy/redmist/buff/jq.tres\")!=0:
	Fight.add_buff_path(\"res://little_game/fight/res/buff/blood.tres\",1,get_enemy(team))"
exe_time = "after_hit"
is_who = true
metadata/_custom_type_script = "uid://skro7sm8drh8"

[sub_resource type="Resource" id="Resource_slf4w"]
script = ExtResource("19_hls36")
eff = SubResource("Resource_0wkv3")
description = "[受到攻击后]施加1层流血
若自身带有过人的技巧，则额外施加1层流血"
name_ = "后发制人"
