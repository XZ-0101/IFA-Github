[sub_resource type="Resource" id="Resource_mwmma"]
script = ExtResource("20_phqsb")
code = "
if Fight.get_buff_x_with_res(team,\"res://little_game/fight/res/enemy/redmist/buff/rmb3.tres\")==0:
	if hp==hp_max*0.5:
		hp=hp_max*0.65
		Fight.add_buff_path(\"res://little_game/fight/res/enemy/redmist/buff/rmb3.tres\",1,team)"
exe_time = "turn_strat"
metadata/_custom_type_script = "uid://skro7sm8drh8"

