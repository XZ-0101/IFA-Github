script = ExtResource("1_bd15d")
code = "var num
num=Fight.get_buff_x_with_res(team,\"res://little_game/fight/res/enemy/yiyu/BUFF/czy.tres\")
print(num)
if num!=0:
	Fight.add_buff_path(\"res://little_game/fight/res/enemy/yiyu/BUFF/happiness.tres\",num,get_enemy(team))
	Fight.minus_buff_path(\"res://little_game/fight/res/enemy/yiyu/BUFF/czy.tres\",team,num)
sp+=10
ehp+=10"
