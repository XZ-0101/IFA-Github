[sub_resource type="Resource" id="Resource_17c2e"]
script = ExtResource("1_xev8o")
code = "var bleed = Fight.get_buff_x_with_type(get_enemy(team), \"res://little_game/fight/res/buff/blood.tres\")
var recover = floor(bleed / 3)
if recover > 0:
	sp = min(sp + recover, sp_max)
	Fight.play_anima(\"text\", team, \"hel,\" + str(recover) + \",sp\")


hit_area+=0.5"
exe_time = "before_hit"
is_who = true
one_time = true
metadata/_custom_type_script = "uid://skro7sm8drh8"

[sub_resource type="Resource" id="Resource_x2qh8"]
script = ExtResource("1_xev8o")
code = "var bleed = Fight.get_buff_x_with_type(get_enemy(team), \"res://little_game/fight/res/buff/blood.tres\")
if bleed != 0:

	ehp -= bleed
	Fight.play_anima(\"text\", get_enemy(team), \"hit,\" + str(bleed) + \",hp\")

	Fight.remove_buff_path(\"res://little_game/fight/res/buff/blood.tres\",get_enemy(team))

	var stack = floor(bleed / 3)
	if stack > 0:
		Fight.add_buff_path(\"res://little_game/fight/res/enemy/redmist/buff/jq.tres\", stack, team)
"
exe_time = "after_hit"
metadata/_custom_type_script = "uid://skro7sm8drh8"

