[sub_resource type="Resource" id="Resource_l5ifl"]
script = ExtResource("1_6s2ec")
code = "for i in range(1,3):
	if Fight.get_buff_x_with_res(team,\"res://little_game/fight/res/enemy/redmist/buff/jq.tres\")!=0:
		Fight.add_buff_path(\"res://little_game/fight/res/buff/blood.tres\",2,get_enemy(team))
		Fight.minus_buff_path(\"res://little_game/fight/res/enemy/redmist/buff/jq.tres\",team,1)"
exe_time = "after_hit"
is_who = true
one_time = true
metadata/_custom_type_script = "uid://skro7sm8drh8"

