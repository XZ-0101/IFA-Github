[sub_resource type="Resource" id="Resource_37ikf"]
script = ExtResource("5_47t2k")
"介绍" = "触发遭遇战"
win_text = "“啧，难道说你也是刚才那种怪物？”$s尽管能看出，收尾人并没有使出多少力量，也可能是[NULL]的调谐，但武器已经向你砍来。"
