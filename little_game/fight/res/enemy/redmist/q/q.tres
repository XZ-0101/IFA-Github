[resource]
script = ExtResource("2_mm0wc")
img = ExtResource("1_774ts")
name_ = "血雾弥漫"
subject = "投稿-鱼翅-01"
"问题" = "满是血色浓雾的十字路口，听到了不远处的喊声。$s“喂，这附近有能出去的路吗？”$s似乎是一名收尾人，站在你面前询问着。$s“您是…”$s尽管能感觉出面前的收尾人是，或者曾是鼎鼎有名的大人物…但你却完全没有头绪。$s“如果你们也是在这个地方迷路的，那我就自己去找好了。"
item = Array[ExtResource("1_u2e3y")]([SubResource("Resource_n37d5"), SubResource("Resource_q221s"), SubResource("Resource_37ikf")])
with_fight = true
metadata/_custom_type_script = "uid://cm1g2p3y1vl0v"
