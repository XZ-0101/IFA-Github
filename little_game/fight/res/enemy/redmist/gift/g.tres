script = ExtResource("1_nijac")
code = "max_point += 2

var bleed = Fight.get_buff_x_with_res(get_enemy(team), \"res://little_game/fight/res/buff/blood.tres\")
print(bleed, \"-bleed\")

if bleed != 0:
	var stack = floori(bleed / 2)
	print(\"stack\", stack)
	if stack > 0:
		Fight.add_buff_path(\"res://little_game/fight/res/enemy/redmist/buff/jq.tres\", stack, team)

if \"守备\" in enow_skill.type or \"恐慌\" in enow_skill.type:
	hit_area += 0.3"
exe_time = "before_hit"
