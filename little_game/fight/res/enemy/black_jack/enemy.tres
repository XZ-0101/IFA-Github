[sub_resource type="Resource" id="Resource_ldaw4"]
script = ExtResource("3_mxcul")
code = "card1(get_enemy(team))
card1(get_enemy(team))
card1(team)
Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/anpai.tres\",1,team)"
exe_time = "turn_strat"
func_code = "func card1(who:int):
	var num=randi_range(1,13)
	
	match num:
		1:
			var Anum=randi_range(1,2)
			if Anum==1:
				Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/ABUFF.tres\",1,who)
			else:
				Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/ABUFF.tres\",11,who)
		2:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/2BUFF.tres\",2,who)
		3:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/3BUFF.tres\",3,who)
		4:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/4BUFF.tres\",4,who)
		5:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/5BUFF.tres\",5,who)
		6:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/6BUFF.tres\",6,who)
		7:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/7BUFF.tres\",7,who)
		8:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/8BUFF.tres\",8,who)
		9:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/9BUFF.tres\",10,who)
		10:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/10BUFF.tres\",10,who)
		11:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/JBUFF.tres\",10,who)
		12:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/QBUFF.tres\",10,who)
		13:
			Fight.add_buff_path(\"res://little_game/fight/res/enemy/black_jack/buff/KBUFF.tres\",10,who)"
metadata/_custom_type_script = "uid://skro7sm8drh8"

[sub_resource type="Resource" id="Resource_3fmsx"]
script = ExtResource("2_g32vd")
eff = SubResource("Resource_ldaw4")
description = "抽牌
[回合开始时]给敌方任意2种“扑克牌”，并使两种扑克牌的层数分别等于他们代表的数字

给自己的随机一种扑克牌和1层暗牌，并使扑克牌的层数分别等于他们代表的数字

可能抽到的牌有：
扑克牌A，扑克牌2，扑克牌3，扑克牌4，扑克牌5，扑克牌6，扑克牌7，扑克牌8，扑克牌9，扑克牌10，扑克牌J，扑克牌Q，扑克牌K
（A的层数按11或1算，随机分配，2-10的层数按面值算，J,Q,K的层数按10算）"
name_ = "抽牌"
metadata/_custom_type_script = "uid://dlbwxbchhwd4o"

