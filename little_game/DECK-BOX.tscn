[sub_resource type="GDScript" id="GDScript_ct7yv"]
script/source = "extends Control

@export var deck:deck_box
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	load_me()
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if $Timer2.time_left>=0.01:
		$TextureProgressBar.value=(1-$Timer2.time_left/$Timer2.wait_time)*100
	else:
		$TextureProgressBar.value=100
	$panic.visible=LittleGameCtrl.panic
	pass


func _on_timer_2_timeout() -> void:
	print(\"a\")
	LittleGameCtrl.now_level+=1
	LittleGameCtrl.now_card=deck
	LittleGameCtrl.now_point=0
	LittleGameCtrl.max_point=deck.max_point if not deck.is_trun else deck.card.size()
	jumper.show_()
	jumper.jump_to(load(\"res://little_game/a_point.tscn\"))
	$TextureProgressBar.hide()
	if LittleGameCtrl.panic:
		LittleGameCtrl.n_sp=LittleGameCtrl.sp
	pass # Replace with function body.


func _on_button_button_down() -> void:
	$Timer2.start()
	$TextureProgressBar.show()
	pass # Replace with function body.






func _on_texture_button_toggled(toggled_on: bool) -> void:
	if toggled_on:
		$Control/TextureRect4/AnimationPlayer.play(\"new_animation\")
	else :
		$Control/TextureRect4/AnimationPlayer.play_backwards(\"new_animation\")
	pass # Replace with function body.


func _on_button_button_up() -> void:
	$Timer2.stop()
	$TextureProgressBar.hide()
	pass # Replace with function body.
func load_me():
	$Panel/type.text=\"\"
	$img/name.text=deck.name_
	
	var ma = $img.material as ShaderMaterial
	ma.set_shader_parameter(\"overlay_texture\",deck.img)
	ma.set_shader_parameter(\"overlay_offset\",deck.img_off)
	ma.set_shader_parameter(\"scale_y\",deck.img_sy)
	ma.set_shader_parameter(\"scale_x\",deck.img_sx)
	
	if deck.is_trun:
		$Panel/type.append_text(tr(\"-故事\\n\"))
	for i in deck.type:
		$Panel/type.append_text(\"-\"+tr(i)+\"\\n\")
"

