Qliphoth_Counter = "5"
red_def = 0.8
white_def = 1.2
black_def = 0.5
pale_def = 1.5
Upgrades = Array[String](["Ⅰ. 设施内每有5名员工或文职死亡，“大鸟”的逆卡巴拉计数器就会立刻减少。（被处决弹击杀的职员不会计入", "Ⅱ. 当工作结果为差时，“大鸟”的逆卡巴拉计数器会立刻减少。", "Ⅲ. 当工作结果为优时，“大鸟”的逆卡巴拉计数器会立刻增加。", "Ⅳ. 发生二级警报时，“大鸟”会直接突破收容。", "Ⅴ. 突破收容后，“大鸟”所在的部门会发生大停电。身处停电区域的员工可能会在“大鸟”摇灯后对其着魔，着魔的员工一遇到“大鸟”就会被它咬掉脑袋。", "Ⅵ. 员工着魔时只会受到轻微的伤害，此时他们的处境还算安全。一旦着魔时间过长，他们会失去控制并慢慢靠近“大鸟”。", "Ⅶ. 着魔的员工只要离开停电区域就能恢复正常。"])
story = "该异想体是一只有着许多眼睛的大鸟，它拿着一盏永不熄灭的明灯。

该异想体会全神贯注地盯着自己遇见的目标，并一口咬下他们的头，不管他是老还是少。这种生物不像普通鸟类那样长有翅膀，取而代之的是一双长长的，可以抓握东西的手臂。一只看上去像是眼球的小鸟总是围绕在该异想体的四周。

有传闻说，在深深的黑森林里有一只怪物...
为了保护森林里的动物免遭怪物侵害，大鸟把自己所有的羽毛卷成了一个灯芯。它又用那个灯芯制作出一盏永不熄灭的明灯。
它拿着永不熄灭的明灯漫步在森林中，警告那些可怕的怪物远离森林深处。
多亏了这只大鸟，怪物袭击的次数减少了很多。但大鸟仍为那些死在怪物口中的动物感到难过。
大鸟突然有了一个想法，“如果我先杀死这些动物，它们就不会被那些怪物杀死了呀。”
之后，可怕的传闻传遍了各处——森林里有一只可怕的怪物会一口咬掉你的头...
据说，那个怪物还会仔细盯着受害者，并看它是否是“引诱动物的怪物”...
这则故事源自████区的████镇。这是从镇上年事最高的████那里流传出来的最古老的传闻之一。尽管人们普遍认为这则故事只是为了防止调皮的孩子进入森林，但这具体是谁写下的？目前还不得而知。

然而这则故事并不是凭空杜撰出来的。“我们在森林里找到了大鸟，后来我们开始寻找‘引诱动物的怪物’。我们找遍了森林的每一个角落。一个月后，我们得出了结论：除了那只大鸟外，那些所谓的怪物根本就不存在。”

“这只异想体肯定不懂‘死亡’的概念。这家公司的异想体大致可分为两类。第一种非常明白‘死亡’是什么，但是天性好斗并喜欢杀戮；第二种知晓‘死亡’的概念，但在杀戮的时候完全感受不到任何负面情绪。然而这只异想体两者都不是。对它而言，死亡本身就是一种救赎。例如它扯下了一个在森林里迷路的小女孩的头，它非但不觉得自己夺去了小女孩的生命，反而觉得自己把小女孩从怪物口中救了下来。”

“当这个生物睁开眼睛的时候，我们什么都做不了。它就这么直勾勾地盯着我们，如果让它继续看着的话...（省略）...我们首先需要做的事就是让它睡着。当它把所有的眼睛都闭上后，我们才能开始工作。”"
Observation_level = "Ⅰ. 工作速度 + 3Ⅱ. 成功率 + 3%Ⅲ. 工作速度 + 3、解锁E.G.O饰品Ⅳ. 成功率 + 3%、解锁E.G.O武器、护甲"
flavour_text = Array[String](["大鸟最引人注意的特点就是全身上下无数的眼睛以及手中那盏永不熄灭的明灯", "事实上，我们并不知道大鸟杀戮的目的是什么。", "大鸟并不能飞对我们来说是个值得庆幸的事。如果它能飞的话，公司里半数员工的脑袋都会被咬下来。", "大鸟突然灵光一现：“如果我先杀死这些动物，它们就不会被那些怪物杀死了呀。”从那之后，森林回归了平静。", "无数眼睛眨动时发出的怪声和灯火燃烧的声响在整个收容室中回荡着。", "大鸟的眼睛和那盏灯在黑暗的收容室里像星星一样闪闪发光。", "大鸟的许多眼睛突然间全部指向了员工", "面对着大鸟，员工紧张地左摇右摆着。", "在员工的背后，可以听到毛茸茸黑色大鸟那低沉的声音。", "可以听到那只鸟零星的叫声。", "大鸟在员工背后低吼，看起来它似乎很焦虑", "大鸟在员工身边徘徊着，低吼着。", "员工扭开了头，试图回避眼神接触。员工看到了那盏燃烧着的明灯。", "在扭过头去以避免眼神接触的员工面前，有一盏耀眼的明灯。", "不直视大鸟是个非常明智的选择。", "大鸟的眼睛渐渐变成了深红色。", "大鸟发出可怕的声音，渐渐靠近了过来。", "大鸟用牙齿发出了声响。", "大鸟走向了员工", "原版翻译缺失这一文本。切换至修正后翻译以查看。", "员工的头在收容室的地板上滚来滚去(以下文本在正常游戏中不会触发。)", "员工的头被很容易地拔了下来。（以下文本在正常游戏中不会触发。）", "大鸟像除草一样用喙将员工的头拔了下来。（以下文本在正常游戏中不会触发）"])
other_info = "大鸟（O-02-40）是一只体型庞大的鸟形异想体。它有着大量散发着黄光的眼睛，一个尖锐的鸟喙。大鸟浑身上下一片漆黑，没有羽毛，长有两只可以抓握物件的爪子，其中一只抓着一个从未熄灭的灯。

[center]
[table=2]
[cell border=#ffffa1]基础工作速度[/cell][cell border=#ffffa1]工作冷却[/cell]
[cell border=#ffffa1]0.33[/cell][cell border=#ffffa1]10[/cell]
[/table]
[/center]

[img]res://res_pack/O-02-40/benti/img/BigBirdCloseUp.webp[/img][color=red]
收容单元监控画面[/color]
"
other_info_act = "出逃信息

出逃的“大鸟”的生命值为1600，基础移动速度为1单位。

尽管“大鸟”的基础移动速度为1单位，其正常情况下出逃时的移动速度为150%。

由于月计的传统艺能，“大鸟”的收容单元不会受到熔毁影响。

出逃时，“大鸟”当前所在的部门会发生大停电，所有走廊会变得更暗。该停电效果的作用仅有提醒主管大鸟的魅惑生效范围，并不能影响部门内其余设施，比如再生反应堆和收容单元的正常运转。

“大鸟”只对员工具有仇恨，且只有一种攻击方式。它会在设施内游荡，并每隔一段时间晃动手中的灯笼，对其所在部门内一个不处于工作状态的随机职员施加一个黄色的标记。标记有40%概率选择文职，60%概率选择员工。大鸟摇灯时若选择标记员工，会优先选择停电部门里最大生命值最低的员工，若选择文职则是随机选择。

如果被标记的员工离开停电的区域，则标记就会被移除。就地进入受影响部门内异想体收容单元的职员虽然不会被“大鸟”选中，但其标记仍然不会被移除，除非该异想体为“3月27日的避难所”或“我们可以改变一切”。

被标记的职员会拥有更高的抗性（黄色标记全抗额外乘算0.5，橙色和红色标记全抗免疫）。如果黄色标记存在15秒而未被移除，则会变成橙色，如果橙色标记存在25秒而未被移除，则会变为红色，并在短暂时间后被红色标记标记的职员将会不受主管控制并走向“大鸟”。“大鸟”也会主动前往被标记的职员所在的位置。

被标记的职员在走到“大鸟”面前时，会被“大鸟”以斩首的方法立刻杀死，不论其是否已被“大鸟”控制。
如若员工当前的生命值低于其最大生命值的30%，无论该员工是否被标记，该员工在经过“大鸟”面前时，都将被视为已标记且触发“大鸟”的斩首能力。
当“大鸟”所处部门内没有任何被标记的职员时，如若有文职经过“大鸟”面前，该文职将有30%的概率立刻被“大鸟”视为已标记并触发斩杀。但由于这里的30%为逐帧判定，实际上该斩杀的触发概率无限接近于100%。
未满足上述条件的职员则可以安全的走过“大鸟”的前方。

“大鸟”还能斩首被“红舞鞋”，“裸巢”等异想体控制的职员，但“大鸟”一次只能斩首一名职员。在斩首动画开始时，“大鸟”会对任何伤害免疫，且不能开始对第二名职员的斩首，即使当前职员已被判定死亡。

如果镜头视角以最大放大倍数聚焦于正在行走的“大鸟”，屏幕会摇晃并且每次摇晃时视角无法移动。

当设施内发生二级或二级以上的警报时，若“大鸟”未出逃，则它会在30-40秒内立刻出逃。只要警报等级不低于二级，“大鸟”出逃的过程就会不断重复发生。

镇压建议

镇压“大鸟”的工作在熟练的主管手中一般会进行得较为顺利。虽然“大鸟”拥有瞬间杀死员工和文职的能力，但从标记员工到控制员工所用的时间已足够让主管找到并将被标记的员工拉离所在的部门，而且“大鸟”也并不具备除此之外的攻击方式。同时，因为“大鸟”在标记员工时，会优先标记停电部门内最大生命值最低的员工，因此主管可以在停电的部门边缘安排几个最大生命值较低的员工，而让最大生命值较高的员工前去镇压“大鸟”。这样，“大鸟”就只会标记部门边缘的员工，主管可以较为轻易的解除这些员工身上的标记再把它们拉回作为下一轮标记的诱饵，并让大部队放心镇压“大鸟”。

由于“大鸟”本身没有能直接造成伤害的攻击方式，且攻击方式只有秒杀。因此，除非情况极为混乱，主管一般无需考虑大鸟会斩首生命值低于最大生命值30%的职员，只需专心操控被标记的员工。虽然“大鸟”只会斩首其面前的被标记员工，但鉴于“大鸟”的移动方式，仍然建议将其背后被标记的员工立刻拉离停电区域，否则“大鸟”可能会转身并立刻触发斩首能力。

另外，如果设施内已收容异想体“惩戒鸟”和“审判鸟”，则需要更加警惕“大鸟”的出逃。在设施内无员工装备“薄暝”E.G.O武器或护甲的情况下，鉴于“惩戒鸟”的特性，在“大鸟”出逃后将有可能触发“黑森林”事件，并引来难以对付的“终末鸟”。

使用小红帽雇佣兵和兔子是镇压“大鸟”的好办法。由于“大鸟”只会对职员类单位造成威胁，小红帽雇佣兵和兔子都可以较为轻易的镇压“大鸟”。尽管小红帽雇佣兵镇压“大鸟”的速度较慢，但优点是完全不需要主管多次操纵员工来躲避魅惑，只要主管确保没有任何员工和“大鸟”同部门即可。

最后，请主管镇压“大鸟”时务必等到二级警报解除（即屏幕四角弹出的警报为trumpet1，只有一个感叹号时，代表二级警报已经下降至一级），不然会出现刚回去的“大鸟”又夺门而出的情况，出逃的“大鸟”又会使警报点数增加，这会让对“大鸟”的镇压陷入死循环，从而导致不必要的员工损失或意外情况。

