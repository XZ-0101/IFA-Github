[resource]
script = ExtResource("5_okild")
Attack_Type = 2
acctak_Damage = "2-4"
Probabilities_ = SubResource("Resource_1ijd4")
most_pe_box = "12"
good_Mood_Range = "10-12"
bad_Mood_Range = "0-5"
Norm_Mood_Range = "6-9"
Qliphoth_Counter = "4"
Upgrades = Array[String](["Ⅰ. 员工的勇气等级越高，对“1.76兆赫”进行工作的成功率就越低。主要原因是由于“1.76兆赫”的异想体效应会使得员工的暴力倾向急剧增长。（和管理须知1不同，第一条管理须知的实际效果是：当员工的勇气等级为1时，该员工对1.76兆赫的所有工作基础成功率都将提升至1.2倍。）", "Ⅱ. 当工作结果为良时，“1.76兆赫”的逆卡巴拉计数器有小概率立刻减少。（该条翻译有误。该句中的小概率”应为“中等概率”。）", "Ⅲ. 当工作结果为差时，“1.76兆赫”的逆卡巴拉计数器有大概率立刻减少。", "Ⅳ. 当对“1.76兆赫”进行工作的员工陷入恐慌时，“1.76兆赫”的逆卡巴拉计数器会立刻减少。（该条管理须知因为bug并未生效）", "Ⅴ. 当工作结果为优时，“1.76兆赫”的逆卡巴拉计数器会立刻加一。如果员工在一次工作中成功产出了所有的PE-BOX，“1.76兆赫”的逆卡巴拉计数器会立刻加二。", "Ⅵ. 智能监控摄像头探测到设施周围出现了大量的噪音。鉴于这种情况只发生在“1.76兆赫”的逆卡巴拉计数器归零后，因此我们假定噪音来源于“1.76兆赫”的收容单元。", "Ⅶ. 在“1.76兆赫”的逆卡巴拉计数器回到最大值之前，噪音会逐渐覆盖越来越多的区域。"])
story = "该异想体是一种没有可见形态的异想体现象。在数名员工进入了某一特定区域并表现出相同的症状后，我们才发现了这个异想体。那些员工都经历了神秘的幻视与幻听，他们的心智也受到了一定程度的损伤。

我们将收音机的频率调到1.76兆赫后静静等待。
12分钟后，无线电噪声中突然出现了一个神秘的声音。我们很难理解那个声音的主人说了些什么，他似乎深陷困境之中并在拼命寻求帮助。
17分钟后，神秘的呼救声突然停止了，与此同时我们听到3声巨响，接着是2次较轻的爆炸声及各式各样的惨叫与哭喊，可以推测此刻另一头的局势相当混乱。
23分钟后，所有声音都消失了，只剩下嘈杂的无线电噪声。
25分钟后，一丝白烟从收音机内部冒出。起初我们认为是收音机出了故障，但和预想不同，冒烟并不是机器的问题。
30分钟后，实验区域内的每一个人都莫名地充满了怒火，表现出极端的攻击性并开始殴打对方。

事故发生后，表现出症状的员工拒绝接受心理咨询。（因为没有人员伤亡，所以不能对他们进行强制咨询。）究竟是什么引起了他们的愤怒？我们无从得知。

此后，收容单元的周边区域开始陆续出现神秘的幻象和噪音。
这是我们绝对不能忘记的“那一天”的记录。这个神秘的波动频率把我们带回了那片已被许多人忘却的混乱之地，可它本身绝不能被遗忘。"
Observation_level = "Ⅰ. 工作速度 + 5Ⅱ. 成功率 +5%、解锁E.G.O饰品Ⅲ. 工作速度 + 5、解锁E.G.O护甲Ⅳ. 成功率 + 5%"
flavour_text = Array[String](["员工感到一股不详的压迫感。", "员工感到轻微的悲伤与愤怒。", "员工闻到一丝怪异的味道。", "员工总觉得有人在远处尖叫。"])
other_info = "1.76兆赫（T-06-27）是一种没有确定形态的异想体现象，其收容单元内呈现出了雪花屏幕一般的效果。实际上，该异想体是一段可以在这个收容单元内收听
到的特殊无线电波。

