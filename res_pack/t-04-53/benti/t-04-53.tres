Upgrades = Array[String](["Ⅰ. 当工作结果为优时，“爱娜温”的逆卡巴拉计数器有大概率在倒计时结束后减少。", "Ⅱ. 当工作结果为差时，“爱娜温”的逆卡巴拉计数器有大概率在倒计时结束后减少。"])
story = "这个异想体的表面如同陶瓷一般光滑。她的眼窝是空的，里面长满了正在生长的翠绿植物。

爱娜温，一个渴望成为人的娃娃，她有着一双深情的眼睛，正因如此，她被人们深爱着。

爱娜温被遗弃在黑暗的森林之中。乌鸦们垂涎着她那双闪闪发亮的眼睛，最终偷走了它们。渐渐地，爱娜温的思想，她过去的回忆，还有她的心灵，慢慢地凋零了。

爱娜温，一个渴望成为娃娃的人，用空洞的眼窝注视着一切。她希望归于尘土，于是所有渴望“生”的事物亦将归于尘土。"
Observation_level = "Ⅰ. 工作速度+ 3Ⅱ. 成功率 + 3%、解锁E.G.O饰品Ⅲ. 工作速度 + 3、解锁E.G.O护甲Ⅳ. 成功率 + 3%、解锁E.G.O武器"
flavour_text = Array[String](["她生于虚无，亦归于虚无。", "“爱娜温”正由内而外地枯萎着。", "也许我们是在试图创造一个没有心的人儿。", "永不凋零的鲜花正在绽放。", "员工想躺在花床上来一场安逸的春眠。", "员工被铺满整个收容单元的薰衣草深深地吸引住了。", "在轮回之中，她理解了重生的意义。一切都将消逝，曾经盛开，然后凋零。落叶归根，痕迹将会留存，一切又将回归原点。", "员工的身上涌出了沁人的芳香，而非鲜血。", "鲜花正在每个人的心头怒放。"])
other_info = "爱娜温（T-04-53）是一只粉色的，形似羊驼的异想体。爱娜温没有手臂，长有六条尖而长的腿，脖子上长有一圈明亮的绿叶，以及一颗戴着粉色太阳帽的人形脑袋。爱娜温的口中衔着一串粉色的物质，根据观察日志里的内容来看，这些物质很有可能是薰衣草。它的收容单元内一直有粉色的花瓣围着它飘落。

[center]
